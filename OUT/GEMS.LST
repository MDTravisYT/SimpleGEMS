                            	   744: 			      ; 		ld	C,A
00:00000496 4F              	   745: 	dc.b	$4F
                            	   746: 			      ; 		bit	0,(IX)			; MBOX[0] is block flag from 68k
00:00000497 DD              	   747: 	dc.b	$DD,$CB,$00,$46
00:00000498 CB
00:00000499 00
