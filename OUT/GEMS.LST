                            	   793: 			      ; **************************************  DIGITAL STUFF  *************************************
                            	   794: 			      ; 
                            	   795: 			      ; *
                            	   796: 			      ; *  DACME - do that DAC thing. assumes the the alternate registers are set up as follows
                            	   797: 			      ; *
                            	   798: 			      ; *			B	15H (reset cmd to timer) + CH3 mode bits
                            	   799: 			      ; *			C	control pattern for processing (compression, oversampling)
                            	   800: 			      ; *			DE	pointing into DACFIFO (1F00-1FFF)
                            	   801: 			      ; *			HL	4000H
                            	   802: 			      ; *
