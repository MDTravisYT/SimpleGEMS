00:00000481 38              	   719: 	dc.b	$38,$11
00:00000482 11
                            	   720: 			      ; x68kloop
                            	   721: 			      ; 		ld	C,6			; yes - xfer maxcnt bytes
00:00000483 0E              	   722: 	dc.b	$0E,$06
00:00000484 06
                            	   723: 			      ; ;		ld	C,12			; yes - xfer maxcnt bytes
                            	   724: 			      ; 		bit	0,(IX)			; MBOX[0] is block flag from 68k
00:00000485 DD              	   725: 	dc.b	$DD,$CB,$00,$46
00:00000486 CB
00:00000487 00
00:00000488 46
                            	   726: 			      ; 		jr	NZ,x68klpwt
00:00000489 20              	   727: 	dc.b	$20,$1C
00:0000048A 1C
                            	   728: 			      ; x68klpcont
                            	   729: 			      ; 		ldir
00:0000048B ED              	   730: 	dc.b	$ED,$B0
00:0000048C B0
                            	   731: 			      ; 
                            	   732: 			      ; 	call	DACME
00:0000048D CD              	   733: 	dc.b	$CD,$B7,$02
00:0000048E B7
00:0000048F 02
                            	   734: 			      ; 
                            	   735: 			      ; 		zsub	6			; more than maxcnt left?
00:00000490 D6              	   736: 	dc.b	$D6,$06
00:00000491 06
