                            	  6372: 			      ; *  FMVTBL - contains (6) 7-byte entires, one per voice:
                            	  6373: 			      ; *    byte 0: FRLxxVVV	flag byte, where F=free, R=release phase, L=locked, VVV=voice num
                            	  6374: 			      ; *                       VVV is numbered (0,1,2,4,5,6) for writing directly to key on/off reg
                            	  6375: 			      ; *    byte 1: priority	only valid for in-use (F=0) voices
                            	  6376: 			      ; *    byte 2: notenum	    "
                            	  6377: 			      ; *    byte 3: channel	    "
                            	  6378: 			      ; *    byte 4: lsb of duration timer (for sequenced notes)
                            	  6379: 			      ; *    byte 5: msb of duration timer
                            	  6380: 			      ; *    byte 6: release timer
