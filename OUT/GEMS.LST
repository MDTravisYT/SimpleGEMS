00:00001A46 FD              	  6629: 	dc.b	$FD,$7E,$01
00:00001A47 7E
00:00001A48 01
                            	  6630: 			      ; 		ld	(avlowestp),IY
00:00001A49 FD              	  6631: 	dc.b	$FD,$22,$B5,$17
