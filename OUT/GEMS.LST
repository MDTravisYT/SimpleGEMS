                            	  2479: 			      ; **************************************  MAIN LOOP  *****************************************
                            	  2480: 			      ; 
                            	  2481: 			      ; *
                            	  2482: 			      ; * GETCCBPTR - gets one byte from command queue for channel number, multiplies by 32,
                            	  2483: 			      ; *	and returns pointer to that channel's CCB in IX, as well as the channel #
                            	  2484: 			      ; *	in A
                            	  2485: 			      ; * GETCCBPTR2 - alternate entry point to providing channel # in A (skips GETCBYTE)
                            	  2486: 			      ; *
                            	  2487: 			      ; *	trashes DE
                            	  2488: 			      ; *
                            	  2489: 			      ; 
                            	  2490: 			      ; GETCCBPTR
