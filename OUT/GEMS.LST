                            	     4: 
                            	     5: 			      ; Z80Code		proc	export
                            	     6: 			      ; 
                            	     7: 			      ; ************************************* RESET VECTOR *******************************************
                            	     8: 			      ; 
                            	     9: 			      ; Z80CODEBASE
                            	    10: 			      ; 		di
00:0000021A F3              	    11: 	dc.b	$F3
                            	    12: 			      ; 		im      1
00:0000021B ED              	    13: 	dc.b	$ED,$56
00:0000021C 56
                            	    14: 			      ; 		ld	SP,STACKINIT
00:0000021D 31              	    15: 	dc.b	$31,$20,$1B
00:0000021E 20
00:0000021F 1B
                            	    16: 			      ; 		jp      main
00:00000220 C3              	    17: 	dc.b	$C3,$C3,$08
00:00000221 C3
00:00000222 08
                            	    18: 			      ; 
                            	    19: 			      ; *********************************** 60 Hz Interrupt ******************************************
                            	    20: 			      ; 
                            	    21: 			      ; * but first, let's squeeze in a few variables...
                            	    22: 			      ; 
                            	    23: 			      ; psgcom		db	00H,00H,00H,00H		;  0 command 1 = key on, 2 = key off, 4 = stop snd
00:00000223 00              	    24: 	dc.b	$00
00:00000224 00              	    25: 	dc.b	$00
00:00000225 00              	    26: 	dc.b	$00
00:00000226 00              	    27: 	dc.b	$00
                            	    28: 			      ; psglev		db	0ffH,0ffH,0ffH,0ffH	;  4 output level attenuation (4 bit)
00:00000227 FF              	    29: 	dc.b	$FF
00:00000228 FF              	    30: 	dc.b	$FF
00:00000229 FF              	    31: 	dc.b	$FF
00:0000022A FF              	    32: 	dc.b	$FF
                            	    33: 			      ; psgatk		db	00H,00H,00H,00H		;  8 attack rate
00:0000022B 00              	    34: 	dc.b	$00
00:0000022C 00              	    35: 	dc.b	$00
00:0000022D 00              	    36: 	dc.b	$00
00:0000022E 00              	    37: 	dc.b	$00
                            	    38: 			      ; psgdec		db	00H,00H,00H,00H		; 12 decay rate
00:0000022F 00              	    39: 	dc.b	$00
00:00000230 00              	    40: 	dc.b	$00
00:00000231 00              	    41: 	dc.b	$00
00:00000232 00              	    42: 	dc.b	$00
                            	    43: 			      ; psgslv		db	00H,00H,00H,00H		; 16 sustain level attenuation
00:00000233 00              	    44: 	dc.b	$00
00:00000234 00              	    45: 	dc.b	$00
00:00000235 00              	    46: 	dc.b	$00
00:00000236 00              	    47: 	dc.b	$00
                            	    48: 			      ; psgrrt		db	00H,00H,00H,00H		; 20 release rate
00:00000237 00              	    49: 	dc.b	$00
00:00000238 00              	    50: 	dc.b	$00
00:00000239 00              	    51: 	dc.b	$00
00:0000023A 00              	    52: 	dc.b	$00
                            	    53: 			      ; psgenv		db	00H,00H,00H,00H		; 24 envelope mode 0 = off, 1 = attack, 2 = decay, 3 = sustain, 4
00:0000023B 00              	    54: 	dc.b	$00
00:0000023C 00              	    55: 	dc.b	$00
00:0000023D 00              	    56: 	dc.b	$00
00:0000023E 00              	    57: 	dc.b	$00
                            	    58: 			      ; psgdtl		db	00H,00H,00H,00H		; 28 tone bottom 4 bits, noise bits
00:0000023F 00              	    59: 	dc.b	$00
00:00000240 00              	    60: 	dc.b	$00
00:00000241 00              	    61: 	dc.b	$00
00:00000242 00              	    62: 	dc.b	$00
                            	    63: 			      ; psgdth		db      00H,00H,00H,00H		; 32 tone upper 6 bits
00:00000243 00              	    64: 	dc.b	$00
00:00000244 00              	    65: 	dc.b	$00
00:00000245 00              	    66: 	dc.b	$00
00:00000246 00              	    67: 	dc.b	$00
                            	    68: 			      ; psgalv		db      00H,00H,00H,00H		; 36 attack level attenuation
00:00000247 00              	    69: 	dc.b	$00
00:00000248 00              	    70: 	dc.b	$00
00:00000249 00              	    71: 	dc.b	$00
00:0000024A 00              	    72: 	dc.b	$00
                            	    73: 			      ; whdflg		db      00H,00H,00H,00H		; 40 flags to indicate hardware should be updated
00:0000024B 00              	    74: 	dc.b	$00
00:0000024C 00              	    75: 	dc.b	$00
00:0000024D 00              	    76: 	dc.b	$00
00:0000024E 00              	    77: 	dc.b	$00
                            	    78: 			      ; 
                            	    79: 			      ; 		db	0
00:0000024F 00              	    80: 	dc.b	$00
                            	    81: 			      ; 
                            	    82: 			      ; CMDWPTR		db	0			; cmd fifo wptr @ $36
00:00000250 00              	    83: 	dc.b	$00
                            	    84: 			      ; CMDRPTR		db	0			; read pointer @ $37
00:00000251 00              	    85: 	dc.b	$00
                            	    86: 			      ; 
                            	    87: 			      ; *** psg command processor/envelope emulator
                            	    88: 			      ; 
                            	    89: 			      ; COM		equ	0
                            	    90: 			      ; LEV		equ	4
                            	    91: 			      ; ATK		equ	8
                            	    92: 			      ; DKY		equ	12
                            	    93: 			      ; SLV		equ	16
                            	    94: 			      ; RRT		equ	20
                            	    95: 			      ; MODE		equ	24
                            	    96: 			      ; DTL		equ	28
                            	    97: 			      ; DTH		equ	32
                            	    98: 			      ; ALV		equ	36
                            	    99: 			      ; FLG		equ	40
                            	   100: 			      ; 
                            	   101: 			      ; VBLINT
                            	   102: 			      ; 		ld	(TICKFLG),SP		; msb of SP in TICKFLG+1 will be >0
00:00000252 ED              	   103: 	dc.b	$ED,$73,$3E,$00
00:00000253 73
00:00000254 3E
00:00000255 00
                            	   104: 			      ; 		reti                    	; leave disabled - will be enabled by CHECKTICK
00:00000256 ED              	   105: 	dc.b	$ED,$4D
00:00000257 4D
                            	   106: 			      ; 
                            	   107: 			      ; TICKFLG		dw	0			; (TICKFLG+1) set by ^^
00:00000258 00              	   108: 	dc.b	$00
00:00000259 00              	   109: 	dc.b	$00
                            	   110: 			      ; TICKCNT		db	0			; tick accumulated by CHECKTICK
00:0000025A 00              	   111: 	dc.b	$00
                            	   112: 			      ; 
                            	   113: 			      ; CHECKTICK					; (if TICKFLG+1 is set, then ints are disabled!)
                            	   114: 			      ; 		di
00:0000025B F3              	   115: 	dc.b	$F3
                            	   116: 			      ; 		push	AF
00:0000025C F5              	   117: 	dc.b	$F5
                            	   118: 			      ; 		push	HL
00:0000025D E5              	   119: 	dc.b	$E5
                            	   120: 			      ; 		ld	HL,TICKFLG+1
00:0000025E 21              	   121: 	dc.b	$21,$3F,$00
00:0000025F 3F
00:00000260 00
                            	   122: 			      ; 		ld	A,(HL)			; check TICKFLG+1
00:00000261 7E              	   123: 	dc.b	$7E
                            	   124: 			      ; 		zor	A
00:00000262 B7              	   125: 	dc.b	$B7
                            	   126: 			      ; 		jr	Z,ctnotick		; return if not set yet
00:00000263 28              	   127: 	dc.b	$28,$17
00:00000264 17
                            	   128: 			      ; 
                            	   129: 			      ; 						; at this point, can't reenable ints until we're
                            	   130: 			      ; 						; sure VBL (64 uS) has gone away, so do some
                            	   131: 			      ; 						; DACMEs and a delay (in case DACME is off)
                            	   132: 			      ; 
                            	   133: 			      ; 		ld	(HL),0			; clear flag (ints are disabled!)
00:00000265 36              	   134: 	dc.b	$36,$00
00:00000266 00
                            	   135: 			      ; 		inc	HL			; point to counter
00:00000267 23              	   136: 	dc.b	$23
                            	   137: 			      ; 		inc	(HL)			; and inc it
00:00000268 34              	   138: 	dc.b	$34
                            	   139: 			      ; 
                            	   140: 			      ; 		call	DACME
00:00000269 CD              	   141: 	dc.b	$CD,$B7,$02
00:0000026A B7
00:0000026B 02
                            	   142: 			      ; 
                            	   143: 			      ; 		push	DE
00:0000026C D5              	   144: 	dc.b	$D5
                            	   145: 			      ; 		ld	HL,(SBPTACC)		; add sub beats per tick to its accumulator
00:0000026D 2A              	   146: 	dc.b	$2A,$C0,$08
00:0000026E C0
00:0000026F 08
                            	   147: 			      ; 		ld	DE,(SBPT)
00:00000270 ED              	   148: 	dc.b	$ED,$5B,$BE,$08
00:00000271 5B
00:00000272 BE
00:00000273 08
                            	   149: 			      ; 		zadd	HL,DE
00:00000274 19              	   150: 	dc.b	$19
                            	   151: 			      ; 		ld	(SBPTACC),HL		; this is all 8 frac bits, so (SBPTACC+1)
00:00000275 22              	   152: 	dc.b	$22,$C0,$08
00:00000276 C0
