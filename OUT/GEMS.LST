                            	   207: ;
                            	   208: ; stdsetup - setup these regs:
                            	   209: ;  d1 - the old value of wptr
                            	   210: ;  a0 - Z80RAM+$36(wptr)
                            	   211: ;  a1 - Z80RAM+$1B40(fifo)
                            	   212: ; also save the sr, turns off ints, and holds the z80
                            	   213: ;
                            	   214: stdsetup
00:00006A10 205F            	   215:           move.l    (sp)+,a0       ; get the return addr
00:00006A12 4E560000        	   216:           link a6,#0               ; set up the link
00:00006A16 48E74040        	   217:           movem.l   d1/a1,-(sp)         ; save some regs
00:00006A1A 40E7            	   218:           move.w    sr,-(SP)
                            	   219: 
00:00006A1C 2F08            	   220:           move.l    a0,-(sp)       ; push the return addr
                            	   221: 
00:00006A1E 41F900A00036    	   222:           lea  Z80RAM+$36,a0       ; a0 points to wptr
00:00006A24 43F900A01B40    	   223:           lea  Z80RAM+$1B40,a1          ; a1 points to fifo
                            	   224: 
00:00006A2A 007C0700        	   225:           or.w #$0700,sr      ; disable ints
                            	   226: 
00:00006A2E 33FC010000A11100	   227:           move.w    #$100,BUSREQ        ; Z80 bus request on
00:00006A36 0839000000A11100	   228: sslp      btst.b    #0,BUSREQ      ; spin on bus grant
00:00006A3E 66F6            	   229:           bne.s     sslp
                            	   230: 
00:00006A40 1210            	   231:           move.b    (a0),d1             ; d1 is write index into fifo
00:00006A42 4881            	   232:           ext.w     d1             ; extend to 16 bits
                            	   233: 
00:00006A44 4E75            	   234:           rts
                            	   235: 
                            	   236: ;
                            	   237: ; stdcleanup - clean up after stdsetup - JMP here only!!!
                            	   238: ;
                            	   239: stdcleanup
00:00006A46 33FC000000A11100	   240:           move.w    #$0,BUSREQ          ; Z80 bus request off
00:00006A4E 46DF            	   241:           move.w    (sp)+,sr
00:00006A50 4CDF0202        	   242:           movem.l   (sp)+,d1/a1
00:00006A54 4E5E            	   243:           unlk a6
00:00006A56 4E75            	   244:           rts
                            	   245: 
                            	   246: ;
                            	   247: ; stdcmdwrite - write a command to the z80(-1, d0), assuming:
                            	   248: ;  d0 - the byte
                            	   249: ;  d1 - the value of wptr
                            	   250: ;  a0 - Z80RAM+$36(wptr)
                            	   251: ;  a1 - Z80RAM+$1B40(fifo)
                            	   252: ;
                            	   253: stdcmdwrite
00:00006A58 13BC00FF1000    	   254:           move.b    #-1,0(a1,d1.w)          ; write into fifo
                            	   255: 
00:00006A5E 5201            	   256:           addq.b    #1,d1               ; increment write index mod 64
00:00006A60 0201003F        	   257:           andi.b    #$3F,d1
                            	   258: ; fall through to stdwrite
                            	   259: 
                            	   260: ;
                            	   261: ; stdwrite - write a byte to the z80, assuming:
                            	   262: ;  d0 - the byte
                            	   263: ;  d1 - the value of wptr
                            	   264: ;  a0 - Z80RAM+$36(wptr)
                            	   265: ;  a1 - Z80RAM+$1B40(fifo)
                            	   266: ;
                            	   267: stdwrite
