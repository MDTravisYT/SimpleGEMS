00:00000429 20              	   574: 	dc.b	$20,$0B
00:0000042A 0B
                            	   575: 			      ; 
                            	   576: 			      ; 		ld	HL,(x68ksrclsb)		; single bank - easy: get back src addr[15:0]
00:0000042B 2A              	   577: 	dc.b	$2A,$F7,$01
00:0000042C F7
00:0000042D 01
                            	   578: 			      ; 		inc	C			; C <- byte count
00:0000042E 0C              	   579: 	dc.b	$0C
                            	   580: 			      ; 		ld	B,A			; B <- src addr msb
00:0000042F 47              	   581: 	dc.b	$47
                            	   582: 			      ; 
                            	   583: 			      ; 		call	xfer68ksafe
00:00000430 CD              	   584: 	dc.b	$CD,$3D,$02
00:00000431 3D
00:00000432 02
                            	   585: 			      ; 
                            	   586: 			      ; 		pop	IX
00:00000433 DD              	   587: 	dc.b	$DD,$E1
00:00000434 E1
                            	   588: 			      ; 		ret
00:00000435 C9              	   589: 	dc.b	$C9
                            	   590: 			      ; 
                            	   591: 			      ; x68kcrosses					; C = count-1, L=over-1
                            	   592: 			      ; 		ld	B,A			; B <- src addr msb
00:00000436 47              	   593: 	dc.b	$47
                            	   594: 			      ; 		push	BC			; push src addr msb (B)
00:00000437 C5              	   595: 	dc.b	$C5
                            	   596: 			      ; 		push	HL			; push over-1 (L)
00:00000438 E5              	   597: 	dc.b	$E5
                            	   598: 			      ; 		ld	A,C
00:00000439 79              	   599: 	dc.b	$79
                            	   600: 			      ; 		zsub	L
00:0000043A 95              	   601: 	dc.b	$95
                            	   602: 			      ; 		ld	C,A			; C <- C - L = count - over (byte count for 1st part)
00:0000043B 4F              	   603: 	dc.b	$4F
                            	   604: 			      ; 		ld	HL,(x68ksrclsb)		; HL <- src addr[15:0]
00:0000043C 2A              	   605: 	dc.b	$2A,$F7,$01
00:0000043D F7
00:0000043E 01
                            	   606: 			      ; 
                            	   607: 			      ; 		call	xfer68ksafe		; xfer away
00:0000043F CD              	   608: 	dc.b	$CD,$3D,$02
00:00000440 3D
00:00000441 02
                            	   609: 			      ; 
                            	   610: 			      ; 		pop	HL			; L <- over-1
00:00000442 E1              	   611: 	dc.b	$E1
                            	   612: 			      ; 		pop	BC			; B <- src addr msb
00:00000443 C1              	   613: 	dc.b	$C1
                            	   614: 			      ; 		ld	C,L
00:00000444 4D              	   615: 	dc.b	$4D
                            	   616: 			      ; 		inc	C			; C <- over count
00:00000445 0C              	   617: 	dc.b	$0C
                            	   618: 			      ; 		ld	A,(x68ksrcmid)
00:00000446 3A              	   619: 	dc.b	$3A,$F8,$01
00:00000447 F8
00:00000448 01
                            	   620: 			      ; 		zand	80H
00:00000449 E6              	   621: 	dc.b	$E6,$80
00:0000044A 80
