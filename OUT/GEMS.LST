                            	  2519: 			      ; *
                            	  2520: 			      ; 
                            	  2521: 			      ; SBPT		dw	204			; sub beats per tick (8frac), default is 120bpm
00:00000AD8 CC              	  2522: 	dc.b	$CC
00:00000AD9 00              	  2523: 	dc.b	$00
                            	  2524: 			      ; SBPTACC		dw	0			; accumulates ^^ each tick to track sub beats
00:00000ADA 00              	  2525: 	dc.b	$00
00:00000ADB 00              	  2526: 	dc.b	$00
                            	  2527: 			      ; TBASEFLAGS	db	0
00:00000ADC 00              	  2528: 	dc.b	$00
                            	  2529: 			      ; 
                            	  2530: 			      ; main						; ints are disabled upon entry here
                            	  2531: 			      ; 		exx				; initialize alternate regs for DACME calls
00:00000ADD D9              	  2532: 	dc.b	$D9
