                            	  6737: 			      ; MBOXES		equ	$1B20			; 32 bytes for mail boxes
                            	  6738: 			      ; CMDFIFO		equ	$1B40			; command fifo - 64 bytes
                            	  6739: 			      ; CCB		equ	$1B80			; CCB - 512 bytes
                            	  6740: 			      ; CH0BUF		equ	$1D80			; channel cache - 256 bytes
                            	  6741: 			      ; ENV0BUF		equ	$1E80			; envelope buffers - 128 bytes
                            	  6742: 			      ; DACFIFO		equ	$1F00			; DAC data FIFO - 256 bytes
