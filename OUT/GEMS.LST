00:000004D7 CB              	   820: 	dc.b	$CB,$46
00:000004D8 46
                            	   821: 			      ; 		jp	Z,dacmespin
00:000004D9 CA              	   822: 	dc.b	$CA,$BB,$02
00:000004DA BB
00:000004DB 02
                            	   823: 			      ; 
                            	   824: 			      ; 		inc	L			; point HL to FM data register
00:000004DC 2C              	   825: 	dc.b	$2C
                            	   826: 			      ; 		ld	(HL),B			; reset timer (sets CH3 mode bits)
