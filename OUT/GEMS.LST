                            	  5835: 			      ; 
                            	  5836: 			      ; *
                            	  5837: 			      ; * WRITEFM - write a string of values to the FM chip. BC points to a null-terminated
                            	  5838: 			      ; *   list of reg/data pairs, where data is an offset off of IX. if data is 0, the
                            	  5839: 			      ; *   indirection is skipped and a 0 written (for the "proprietary register")
                            	  5840: 			      ; *   H <- 40H (MSB of FM chip register address)
                            	  5841: 			      ; *   D <- 0 for bank 0 (channels 0,1,2) or 2 for bank 1 (channels 3,4,5)
                            	  5842: 			      ; *   E <- channel within bank (0-2)
                            	  5843: 			      ; *
                            	  5844: 			      ; 		export	WRITEFM
                            	  5845: 			      ; WRITEFM
                            	  5846: 			      ; 		ld	A,(BC)			; get reg num
00:000017EA 0A              	  5847: 	dc.b	$0A
                            	  5848: 			      ; 		zor	A
00:000017EB B7              	  5849: 	dc.b	$B7
                            	  5850: 			      ; 		ret	Z			; (0 = EOT)
00:000017EC C8              	  5851: 	dc.b	$C8
                            	  5852: 			      ; 		inc	BC
00:000017ED 03              	  5853: 	dc.b	$03
                            	  5854: 			      ; 
