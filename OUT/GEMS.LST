                            	  6478: 			      ; VTBLPRIO	equ	1
                            	  6479: 			      ; VTBLCH		equ	3
                            	  6480: 			      ; VTBLDL		equ	4
                            	  6481: 			      ; VTBLDH		equ	5
                            	  6482: 			      ; VTBLRT		equ	6
                            	  6483: 			      ; 
