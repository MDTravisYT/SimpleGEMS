                            	  6457: 			      ; 
                            	  6458: 			      ; *  ALLOC     - dynamic voice allocation routine
                            	  6459: 			      ; *  ALLOCSPEC - special entry point for only allocating or not the single voice at (IY)
                            	  6460: 			      ; *
                            	  6461: 			      ; *	parameters:	B	channel
                            	  6462: 			      ; *			IX	pointer to this channel's CCB
                            	  6463: 			      ; *			IY	first entry in appropriate voice table
                            	  6464: 			      ; *
                            	  6465: 			      ; *	uses:		?????
                            	  6466: 			      ; *
                            	  6467: 			      ; *	returns:	A	flags of voice allocated, or FF if none allocated
                            	  6468: 			      ; *			HL	pointer to entry allocated
                            	  6469: 			      ; 
                            	  6470: 			      ; avlowestp	dw	0			; pointer to lowest priority
00:000019D1 00              	  6471: 	dc.b	$00
00:000019D2 00              	  6472: 	dc.b	$00
                            	  6473: 			      ; avfreestp	dw	0			; pointer to longest free
00:000019D3 00              	  6474: 	dc.b	$00
