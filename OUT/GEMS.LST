                            	     4: 			      ; Z80Code		proc	export
                            	     5: 			      ; 
                            	     6: 			      ; ************************************* RESET VECTOR *******************************************
                            	     7: 			      ; 
                            	     8: 			      ; Z80CODEBASE
                            	     9: 			      ; 		di
00:0000021C F3              	    10: 	dc.b	$F3
                            	    11: 			      ; 		im      1
00:0000021D ED              	    12: 	dc.b	$ED,$56
00:0000021E 56
                            	    13: 			      ; 		ld	SP,STACKINIT
00:0000021F 31              	    14: 	dc.b	$31,$20,$1B
00:00000220 20
00:00000221 1B
                            	    15: 			      ; 		jp      main
00:00000222 C3              	    16: 	dc.b	$C3,$8A,$08
00:00000223 8A
00:00000224 08
                            	    17: 			      ; 
                            	    18: 			      ; *********************************** 60 Hz Interrupt ******************************************
                            	    19: 			      ; 
                            	    20: 			      ; * but first, let's squeeze in a few variables...
                            	    21: 			      ; 
                            	    22: 			      ; psgcom		db	00H,00H,00H,00H		;  0 command 1 = key on, 2 = key off, 4 = stop snd
00:00000225 00              	    23: 	dc.b	$00
00:00000226 00              	    24: 	dc.b	$00
00:00000227 00              	    25: 	dc.b	$00
00:00000228 00              	    26: 	dc.b	$00
                            	    27: 			      ; psglev		db	0ffH,0ffH,0ffH,0ffH	;  4 output level attenuation (4 bit)
00:00000229 FF              	    28: 	dc.b	$FF
00:0000022A FF              	    29: 	dc.b	$FF
00:0000022B FF              	    30: 	dc.b	$FF
00:0000022C FF              	    31: 	dc.b	$FF
                            	    32: 			      ; psgatk		db	00H,00H,00H,00H		;  8 attack rate
00:0000022D 00              	    33: 	dc.b	$00
00:0000022E 00              	    34: 	dc.b	$00
00:0000022F 00              	    35: 	dc.b	$00
00:00000230 00              	    36: 	dc.b	$00
                            	    37: 			      ; psgdec		db	00H,00H,00H,00H		; 12 decay rate
00:00000231 00              	    38: 	dc.b	$00
00:00000232 00              	    39: 	dc.b	$00
00:00000233 00              	    40: 	dc.b	$00
00:00000234 00              	    41: 	dc.b	$00
                            	    42: 			      ; psgslv		db	00H,00H,00H,00H		; 16 sustain level attenuation
00:00000235 00              	    43: 	dc.b	$00
00:00000236 00              	    44: 	dc.b	$00
00:00000237 00              	    45: 	dc.b	$00
00:00000238 00              	    46: 	dc.b	$00
                            	    47: 			      ; psgrrt		db	00H,00H,00H,00H		; 20 release rate
00:00000239 00              	    48: 	dc.b	$00
00:0000023A 00              	    49: 	dc.b	$00
00:0000023B 00              	    50: 	dc.b	$00
00:0000023C 00              	    51: 	dc.b	$00
                            	    52: 			      ; psgenv		db	00H,00H,00H,00H		; 24 envelope mode 0 = off, 1 = attack, 2 = decay, 3 = sustain, 4
00:0000023D 00              	    53: 	dc.b	$00
00:0000023E 00              	    54: 	dc.b	$00
00:0000023F 00              	    55: 	dc.b	$00
00:00000240 00              	    56: 	dc.b	$00
                            	    57: 			      ; psgdtl		db	00H,00H,00H,00H		; 28 tone bottom 4 bits, noise bits
00:00000241 00              	    58: 	dc.b	$00
00:00000242 00              	    59: 	dc.b	$00
00:00000243 00              	    60: 	dc.b	$00
00:00000244 00              	    61: 	dc.b	$00
                            	    62: 			      ; psgdth		db      00H,00H,00H,00H		; 32 tone upper 6 bits
00:00000245 00              	    63: 	dc.b	$00
00:00000246 00              	    64: 	dc.b	$00
00:00000247 00              	    65: 	dc.b	$00
00:00000248 00              	    66: 	dc.b	$00
                            	    67: 			      ; psgalv		db      00H,00H,00H,00H		; 36 attack level attenuation
00:00000249 00              	    68: 	dc.b	$00
00:0000024A 00              	    69: 	dc.b	$00
00:0000024B 00              	    70: 	dc.b	$00
00:0000024C 00              	    71: 	dc.b	$00
                            	    72: 			      ; whdflg		db      00H,00H,00H,00H		; 40 flags to indicate hardware should be updated
00:0000024D 00              	    73: 	dc.b	$00
00:0000024E 00              	    74: 	dc.b	$00
00:0000024F 00              	    75: 	dc.b	$00
00:00000250 00              	    76: 	dc.b	$00
                            	    77: 			      ; 
                            	    78: 			      ; 		db	0
00:00000251 00              	    79: 	dc.b	$00
                            	    80: 			      ; 
                            	    81: 			      ; CMDWPTR		db	0			; cmd fifo wptr @ $36
00:00000252 00              	    82: 	dc.b	$00
                            	    83: 			      ; CMDRPTR		db	0			; read pointer @ $37
00:00000253 00              	    84: 	dc.b	$00
                            	    85: 			      ; 
                            	    86: 			      ; *** psg command processor/envelope emulator
                            	    87: 			      ; 
                            	    88: 			      ; COM		equ	0
                            	    89: 			      ; LEV		equ	4
                            	    90: 			      ; ATK		equ	8
                            	    91: 			      ; DKY		equ	12
                            	    92: 			      ; SLV		equ	16
                            	    93: 			      ; RRT		equ	20
                            	    94: 			      ; MODE		equ	24
                            	    95: 			      ; DTL		equ	28
                            	    96: 			      ; DTH		equ	32
                            	    97: 			      ; ALV		equ	36
                            	    98: 			      ; FLG		equ	40
                            	    99: 			      ; 
                            	   100: 			      ; VBLINT
                            	   101: 			      ; 		ld	(TICKFLG),SP		; msb of SP in TICKFLG+1 will be >0
00:00000254 ED              	   102: 	dc.b	$ED,$73,$3E,$00
00:00000255 73
00:00000256 3E
00:00000257 00
                            	   103: 			      ; 		reti                    	; leave disabled - will be enabled by CHECKTICK
00:00000258 ED              	   104: 	dc.b	$ED,$4D
00:00000259 4D
                            	   105: 			      ; 
                            	   106: 			      ; TICKFLG		dw	0			; (TICKFLG+1) set by ^^
00:0000025A 00              	   107: 	dc.b	$00
00:0000025B 00              	   108: 	dc.b	$00
                            	   109: 			      ; TICKCNT		db	0			; tick accumulated by CHECKTICK
00:0000025C 00              	   110: 	dc.b	$00
                            	   111: 			      ; 
                            	   112: 			      ; CHECKTICK					; (if TICKFLG+1 is set, then ints are disabled!)
                            	   113: 			      ; 		di
00:0000025D F3              	   114: 	dc.b	$F3
                            	   115: 			      ; 		push	AF
00:0000025E F5              	   116: 	dc.b	$F5
                            	   117: 			      ; 		push	HL
00:0000025F E5              	   118: 	dc.b	$E5
                            	   119: 			      ; 		ld	HL,TICKFLG+1
00:00000260 21              	   120: 	dc.b	$21,$3F,$00
00:00000261 3F
00:00000262 00
                            	   121: 			      ; 		ld	A,(HL)			; check TICKFLG+1
00:00000263 7E              	   122: 	dc.b	$7E
                            	   123: 			      ; 		zor	A
00:00000264 B7              	   124: 	dc.b	$B7
                            	   125: 			      ; 		jr	Z,ctnotick		; return if not set yet
00:00000265 28              	   126: 	dc.b	$28,$17
00:00000266 17
                            	   127: 			      ; 
                            	   128: 			      ; 						; at this point, can't reenable ints until we're
                            	   129: 			      ; 						; sure VBL (64 uS) has gone away, so do some
                            	   130: 			      ; 						; DACMEs and a delay (in case DACME is off)
                            	   131: 			      ; 
                            	   132: 			      ; 		ld	(HL),0			; clear flag (ints are disabled!)
00:00000267 36              	   133: 	dc.b	$36,$00
00:00000268 00
                            	   134: 			      ; 		inc	HL			; point to counter
00:00000269 23              	   135: 	dc.b	$23
                            	   136: 			      ; 		inc	(HL)			; and inc it
00:0000026A 34              	   137: 	dc.b	$34
                            	   138: 			      ; 
                            	   139: 			      ; 		call	DACME
00:0000026B CD              	   140: 	dc.b	$CD,$B7,$02
00:0000026C B7
00:0000026D 02
                            	   141: 			      ; 
                            	   142: 			      ; 		push	DE
00:0000026E D5              	   143: 	dc.b	$D5
                            	   144: 			      ; 		ld	HL,(SBPTACC)		; add sub beats per tick to its accumulator
00:0000026F 2A              	   145: 	dc.b	$2A,$87,$08
00:00000270 87
00:00000271 08
                            	   146: 			      ; 		ld	DE,(SBPT)
00:00000272 ED              	   147: 	dc.b	$ED,$5B,$85,$08
00:00000273 5B
00:00000274 85
00:00000275 08
                            	   148: 			      ; 		zadd	HL,DE
