                            	  1199: 			      ; 
                            	  1200: 			      ; 
                            	  1201: 			      ; ************************************* SEQUENCER CODE ***************************************
                            	  1202: 			      ; 
                            	  1203: 			      ; * CCB Entries:	2,1,0	tag addr of 1st byte in 32-byte channel buffer
                            	  1204: 			      ; *		5,4,3	addr of next byte to fetch
                            	  1205: 			      ; *				so: 0 <= addr-tag <= 31 means hit in buffer
                            	  1206: 			      ; *		6	flags
                            	  1207: 			      ; *		8,7	timer (contains 0-ticks to delay)
                            	  1208: 			      ; *		10,9	delay
                            	  1209: 			      ; *		12,11	duration
                            	  1210: 			      ; 
                            	  1211: 			      ; CCBTAGL		equ	0	; lsb of addr of 1st byte in 32-byte sequence buffer
                            	  1212: 			      ; CCBTAGM		equ	1	; mid of "
                            	  1213: 			      ; CCBTAGH		equ	2	; msb of "
                            	  1214: 			      ; CCBADDRL	equ	3	; lsb of addr of next byte to read from sequence
                            	  1215: 			      ; CCBADDRM	equ	4	; mid of "
                            	  1216: 			      ; CCBADDRH	equ	5	; msb of "
                            	  1217: 			      ; CCBFLAGS	equ	6	; 80 = sustain
                            	  1218: 			      ; 				; 40 = env retrigger
                            	  1219: 			      ; 				; 20 = lock (for 68k based sfx)
                            	  1220: 			      ; 				; 10 = running (not paused)
                            	  1221: 			      ; 				; 08 = use sfx (150 bpm) timebase
                            	  1222: 			      ; 				; 02 = muted (running, but not executing note ons)
                            	  1223: 			      ; 				; 01 = in use
                            	  1224: 			      ; CCBTIMERL	equ	7	; lsb of 2's comp, subbeat (1/24th) timer till next event
                            	  1225: 			      ; CCBTIMERH	equ	8	; msb of "
                            	  1226: 			      ; CCBDELL		equ	9	; lsb of registered subbeat delay value
                            	  1227: 			      ; CCBDELH		equ	10	; msb of "
                            	  1228: 			      ; CCBDURL		equ	11	; lsb of registered subbeat duration value
                            	  1229: 			      ; CCBDURH		equ	12	; msb of "
                            	  1230: 			      ; CCBPNUM		equ	13	; program number (patch)
                            	  1231: 			      ; CCBSNUM		equ	14	; sequence number (in sequence bank)
                            	  1232: 			      ; CCBVCHAN	equ	15	; MIDI channel number within sequence CCBSNUM
                            	  1233: 			      ; CCBLOOP0	equ	16	; loop stack (counter, lsb of start addr, mid of start addr)
                            	  1234: 			      ; CCBLOOP1	equ	19
                            	  1235: 			      ; CCBLOOP2	equ	22
                            	  1236: 			      ; CCBLOOP3	equ	25
                            	  1237: 			      ; CCBPRIO		equ	28	; priority (0 lowest, 127 highest)
                            	  1238: 			      ; CCBENV		equ	29	; envelope number
                            	  1239: 			      ; CCBATN		equ	30	; channel attenuation (0=loud, 127=quiet)
                            	  1240: 			      ; CCBy		equ	31
                            	  1241: 			      ; 
                            	  1242: 			      ; *
                            	  1243: 			      ; *  GETSBYTE - get the channel's sequence byte pointed to by the CCB
                            	  1244: 			      ; *
                            	  1245: 			      ; *	parameters:		IX		points to the current channel's CCB
                            	  1246: 			      ; *				(CHBUFPTR)	points to the current channel's buffer
                            	  1247: 			      ; *	returns:		A		data
                            	  1248: 			      ; *
                            	  1249: 			      ; 
                            	  1250: 			      ; ;BUFSIZE		equ	16
                            	  1251: 			      ; 
                            	  1252: 			      ; GETSBYTE
                            	  1253: 			      ; 
                            	  1254: 			      ; 	call	DACME
00:0000060B CD              	  1255: 	dc.b	$CD,$B7,$02
00:0000060C B7
00:0000060D 02
                            	  1256: 			      ; 
                            	  1257: 			      ; 		push	BC
00:0000060E C5              	  1258: 	dc.b	$C5
                            	  1259: 			      ; 		push	HL
00:0000060F E5              	  1260: 	dc.b	$E5
                            	  1261: 			      ; 
                            	  1262: 			      ; 		ld	A,(IX+CCBADDRL)
00:00000610 DD              	  1263: 	dc.b	$DD,$7E,$03
00:00000611 7E
00:00000612 03
                            	  1264: 			      ; 		zsub	(IX+CCBTAGL)
00:00000613 DD              	  1265: 	dc.b	$DD,$96,$00
00:00000614 96
00:00000615 00
                            	  1266: 			      ; 		ld	C,A			; C <- lsb of addr-tag
00:00000616 4F              	  1267: 	dc.b	$4F
                            	  1268: 			      ; 		ld	A,(IX+CCBADDRM)
00:00000617 DD              	  1269: 	dc.b	$DD,$7E,$04
00:00000618 7E
00:00000619 04
                            	  1270: 			      ; 		sbc	A,(IX+CCBTAGM)		; A <- midbyte of addr-tag
00:0000061A DD              	  1271: 	dc.b	$DD,$9E,$01
00:0000061B 9E
00:0000061C 01
                            	  1272: 			      ; 		jr	NZ,gsbmiss		; if non-zero, its a miss!
00:0000061D 20              	  1273: 	dc.b	$20,$2A
00:0000061E 2A
                            	  1274: 			      ; 		ld	A,(IX+CCBADDRH)
00:0000061F DD              	  1275: 	dc.b	$DD,$7E,$05
00:00000620 7E
00:00000621 05
                            	  1276: 			      ; 		sbc	A,(IX+CCBTAGH)		; A <- high byte of addr-tag
00:00000622 DD              	  1277: 	dc.b	$DD,$9E,$02
00:00000623 9E
00:00000624 02
                            	  1278: 			      ; 		jr	NZ,gsbmiss		; if non-zero, its a miss!
00:00000625 20              	  1279: 	dc.b	$20,$22
00:00000626 22
                            	  1280: 			      ; 		ld	A,C
00:00000627 79              	  1281: 	dc.b	$79
                            	  1282: 			      ; 		cp	16			; if mid and msb ok, is lsb < 16 ?
00:00000628 FE              	  1283: 	dc.b	$FE,$10
00:00000629 10
                            	  1284: 			      ; 		jr	NC,gsbmiss		; no - its a miss
00:0000062A 30              	  1285: 	dc.b	$30,$1D
00:0000062B 1D
                            	  1286: 			      ; gsbhit
                            	  1287: 			      ; 	call	DACME
00:0000062C CD              	  1288: 	dc.b	$CD,$B7,$02
00:0000062D B7
00:0000062E 02
                            	  1289: 			      ; 
                            	  1290: 			      ; 		ld	B,0			; hit!
00:0000062F 06              	  1291: 	dc.b	$06,$00
00:00000630 00
                            	  1292: 			      ; 		ld	HL,(CHBUFPTR)
00:00000631 2A              	  1293: 	dc.b	$2A,$54,$04
00:00000632 54
00:00000633 04
                            	  1294: 			      ; 		zadd	HL,BC			; HL <- ptr to byte in buffer
00:00000634 09              	  1295: 	dc.b	$09
                            	  1296: 			      ; 		ld	A,(HL)			; A <- byte from buffer
00:00000635 7E              	  1297: 	dc.b	$7E
                            	  1298: 			      ; 
                            	  1299: 			      ; 		inc	(IX+CCBADDRL)		; increment addr[23:0]
00:00000636 DD              	  1300: 	dc.b	$DD,$34,$03
00:00000637 34
00:00000638 03
                            	  1301: 			      ; 		jr	NZ,gsbincdone
00:00000639 20              	  1302: 	dc.b	$20,$08
00:0000063A 08
                            	  1303: 			      ; 		inc	(IX+CCBADDRM)
00:0000063B DD              	  1304: 	dc.b	$DD,$34,$04
00:0000063C 34
00:0000063D 04
                            	  1305: 			      ; 		jr	NZ,gsbincdone
00:0000063E 20              	  1306: 	dc.b	$20,$03
00:0000063F 03
                            	  1307: 			      ; 		inc	(IX+CCBADDRH)
00:00000640 DD              	  1308: 	dc.b	$DD,$34,$05
00:00000641 34
00:00000642 05
                            	  1309: 			      ; gsbincdone
                            	  1310: 			      ; 		pop	HL
00:00000643 E1              	  1311: 	dc.b	$E1
                            	  1312: 			      ; 		pop	BC
00:00000644 C1              	  1313: 	dc.b	$C1
                            	  1314: 			      ; 
                            	  1315: 			      ; 	call	DACME
00:00000645 CD              	  1316: 	dc.b	$CD,$B7,$02
00:00000646 B7
00:00000647 02
                            	  1317: 			      ; 
                            	  1318: 			      ; 		ret
00:00000648 C9              	  1319: 	dc.b	$C9
                            	  1320: 			      ; gsbmiss
                            	  1321: 			      ; 
                            	  1322: 			      ; 	call	DACME
00:00000649 CD              	  1323: 	dc.b	$CD,$B7,$02
00:0000064A B7
00:0000064B 02
                            	  1324: 			      ; ;	call	FILLDACFIFO
                            	  1325: 			      ; 	call	CHECKTICK
00:0000064C CD              	  1326: 	dc.b	$CD,$41,$00
00:0000064D 41
00:0000064E 00
                            	  1327: 			      ; ;	call	DACME
                            	  1328: 			      ; 
                            	  1329: 			      ; 		push	DE			; here to refill buffer w/ next 32 bytes in seq
00:0000064F D5              	  1330: 	dc.b	$D5
                            	  1331: 			      ; 		ld	DE,(CHBUFPTR)		; DE <- pointer to buffer
00:00000650 ED              	  1332: 	dc.b	$ED,$5B,$54,$04
00:00000651 5B
00:00000652 54
00:00000653 04
                            	  1333: 			      ; 		ld	L,(IX+CCBADDRL)
00:00000654 DD              	  1334: 	dc.b	$DD,$6E,$03
00:00000655 6E
00:00000656 03
                            	  1335: 			      ; 		ld	(IX+CCBTAGL),L
00:00000657 DD              	  1336: 	dc.b	$DD,$75,$00
00:00000658 75
00:00000659 00
                            	  1337: 			      ; 		ld	H,(IX+CCBADDRM)		; HL <- src addr lsw
00:0000065A DD              	  1338: 	dc.b	$DD,$66,$04
00:0000065B 66
00:0000065C 04
                            	  1339: 			      ; 		ld	(IX+CCBTAGM),H
00:0000065D DD              	  1340: 	dc.b	$DD,$74,$01
00:0000065E 74
00:0000065F 01
                            	  1341: 			      ; 		ld	A,(IX+CCBADDRH)		; A <- src addr msg
00:00000660 DD              	  1342: 	dc.b	$DD,$7E,$05
00:00000661 7E
00:00000662 05
                            	  1343: 			      ; 		ld	(IX+CCBTAGH),A		; tag <- addr
00:00000663 DD              	  1344: 	dc.b	$DD,$77,$02
00:00000664 77
00:00000665 02
                            	  1345: 			      ; 		ld	C,16		; C <- byte count
00:00000666 0E              	  1346: 	dc.b	$0E,$10
00:00000667 10
                            	  1347: 			      ; 		call	XFER68K			; refill away
00:00000668 CD              	  1348: 	dc.b	$CD,$F9,$01
00:00000669 F9
00:0000066A 01
                            	  1349: 			      ; 		pop	DE
00:0000066B D1              	  1350: 	dc.b	$D1
                            	  1351: 			      ; 		ld	C,0
00:0000066C 0E              	  1352: 	dc.b	$0E,$00
00:0000066D 00
                            	  1353: 			      ; 		jr	gsbhit			; and hit on first byte (since we just refilled here)
00:0000066E 18              	  1354: 	dc.b	$18,$BC
00:0000066F BC
                            	  1355: 			      ; 
                            	  1356: 			      ; 
                            	  1357: 			      ; *
                            	  1358: 			      ; *  UPDSEQ - go through the CCB's, updating any enabled channels
                            	  1359: 			      ; *
                            	  1360: 			      ; 
                            	  1361: 			      ; CHBUFPTR	dw	0			; pointer to current channel's sequence buffer
00:00000670 00              	  1362: 	dc.b	$00
