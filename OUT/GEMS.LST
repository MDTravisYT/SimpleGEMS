00:000004CE 00              	   806: 	dc.b	$00
                            	   807: 			      ; DACME4BINST	dw	0			; for saving the DACMEPROC inst for processing
00:000004CF 00              	   808: 	dc.b	$00
00:000004D0 00              	   809: 	dc.b	$00
                            	   810: 			      ; 
                            	   811: 			      ; DACME		jr	DACMEALT		; change to EXX/EX AF to enable, RET to disable
00:000004D1 18              	   812: 	dc.b	$18,$26
00:000004D2 26
