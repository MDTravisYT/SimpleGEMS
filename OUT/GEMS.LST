                            	   269: 
00:00006A68 5201            	   270:           addq.b    #1,d1               ; increment write index mod 64
00:00006A6A 0201003F        	   271:           andi.b    #$3F,d1
00:00006A6E 1081            	   272:           move.b    d1,(a0)             ; write it back
                            	   273: 
00:00006A70 4E75            	   274:           rts
