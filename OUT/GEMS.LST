                            	   792: 			      ; **************************************  DIGITAL STUFF  *************************************
                            	   793: 			      ; 
                            	   794: 			      ; *
                            	   795: 			      ; *  DACME - do that DAC thing. assumes the the alternate registers are set up as follows
                            	   796: 			      ; *
                            	   797: 			      ; *			B	15H (reset cmd to timer) + CH3 mode bits
                            	   798: 			      ; *			C	control pattern for processing (compression, oversampling)
                            	   799: 			      ; *			DE	pointing into DACFIFO (1F00-1FFF)
                            	   800: 			      ; *			HL	4000H
                            	   801: 			      ; *
