                            	   534: 			      ; **************************************  XFER68K  *****************************************
                            	   535: 			      ; 
                            	   536: 			      ; *
                            	   537: 			      ; *  XFER68K - transfers 1 to 255 bytes from 68000 space to Z80. handles 32k block crossings.
                            	   538: 			      ; *
                            	   539: 			      ; *	parameters:		A	68k source address [23:16]
                            	   540: 			      ; *				HL	68k source address [15:0]
                            	   541: 			      ; *				DE	Z80 dest address
                            	   542: 			      ; *				C	byte count (0 is illegal!)
                            	   543: 			      ; *
                            	   544: 			      ; *	trashes:		B
                            	   545: 			      ; *
                            	   546: 			      ; 
                            	   547: 			      ; x68ksrclsb	db	0			; for storing lsw of src addr
00:00000411 00              	   548: 	dc.b	$00
                            	   549: 			      ; x68ksrcmid	db	0
00:00000412 00              	   550: 	dc.b	$00
                            	   551: 			      ; 
                            	   552: 			      ; XFER68K
                            	   553: 			      ; 
                            	   554: 			      ; 	call	DACME
00:00000413 CD              	   555: 	dc.b	$CD,$B7,$02
00:00000414 B7
00:00000415 02
                            	   556: 			      ; 
                            	   557: 			      ; 		push	IX			; save IX - use it to point to DMA block flags
00:00000416 DD              	   558: 	dc.b	$DD,$E5
00:00000417 E5
                            	   559: 			      ; 		ld	IX,MBOXES
00:00000418 DD              	   560: 	dc.b	$DD,$21,$20,$1B
00:00000419 21
00:0000041A 20
00:0000041B 1B
                            	   561: 			      ; 
                            	   562: 			      ; 		ld	(x68ksrclsb),HL		; save src addr[15:0]
00:0000041C 22              	   563: 	dc.b	$22,$F7,$01
00:0000041D F7
00:0000041E 01
                            	   564: 			      ; 		res	7,H			; HL <- src addr[14:0]
00:0000041F CB              	   565: 	dc.b	$CB,$BC
00:00000420 BC
                            	   566: 			      ; 		ld	B,0
00:00000421 06              	   567: 	dc.b	$06,$00
00:00000422 00
