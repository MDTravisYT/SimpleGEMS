                            	  6355: 			      ; 		export	PSGVTBL
                            	  6356: 			      ; 
                            	  6357: 			      ; *  FMVTBL - contains (6) 7-byte entires, one per voice:
                            	  6358: 			      ; *    byte 0: FRLxxVVV	flag byte, where F=free, R=release phase, L=locked, VVV=voice num
                            	  6359: 			      ; *                       VVV is numbered (0,1,2,4,5,6) for writing directly to key on/off reg
                            	  6360: 			      ; *    byte 1: priority	only valid for in-use (F=0) voices
                            	  6361: 			      ; *    byte 2: notenum	    "
                            	  6362: 			      ; *    byte 3: channel	    "
                            	  6363: 			      ; *    byte 4: lsb of duration timer (for sequenced notes)
                            	  6364: 			      ; *    byte 5: msb of duration timer
                            	  6365: 			      ; *    byte 6: release timer
                            	  6366: 			      ; 
