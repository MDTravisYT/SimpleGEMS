00:0000044B C6              	   623: 	dc.b	$C6,$80
00:0000044C 80
                            	   624: 			      ; 		ld	H,A
00:0000044D 67              	   625: 	dc.b	$67
                            	   626: 			      ; 		ld	L,0			; HL <- lsw of start of next bank
00:0000044E 2E              	   627: 	dc.b	$2E,$00
00:0000044F 00
