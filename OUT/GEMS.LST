00:00001A4B B5
00:00001A4C 17
                            	  6632: 			      ; 		jr	avspecprio
00:00001A4D 18              	  6633: 	dc.b	$18,$DA
00:00001A4E DA
                            	  6634: 			      ; 
                            	  6635: 			      ; 
                            	  6636: 			      ; *  DEALLOC - deallocate a voice by searching for a match on notenum and channel.
                            	  6637: 			      ; *    for now - for digital do nuthing
                            	  6638: 			      ; *    if release timer (byte 6) is zero, then set free bit immediately, otherwise
                            	  6639: 			      ; *    set release bit (a 60 Hz routine will count this down and set free when its zero)
                            	  6640: 			      ; *
                            	  6641: 			      ; *	parameters:	B	channel
                            	  6642: 			      ; *			C	note
                            	  6643: 			      ; *			IX	top of voice table
                            	  6644: 			      ; *
                            	  6645: 			      ; *	uses:		D,E,H
                            	  6646: 			      ; *
                            	  6647: 			      ; *	returns:	A	flags byte of deallocated voice, or
                            	  6648: 			      ; *				  0FFH if note not found
                            	  6649: 			      ; 
                            	  6650: 			      ; DEALLOC
                            	  6651: 			      ; 		ld	DE,7
00:00001A4F 11              	  6652: 	dc.b	$11,$07,$00
00:00001A50 07
00:00001A51 00
                            	  6653: 			      ; 		jr	dvstart
00:00001A52 18              	  6654: 	dc.b	$18,$02
00:00001A53 02
                            	  6655: 			      ; dvloop
                            	  6656: 			      ; 		zadd	IX,DE
00:00001A54 DD              	  6657: 	dc.b	$DD,$19
00:00001A55 19
                            	  6658: 			      ; dvstart
                            	  6659: 			      ; 		ld	A,(IX+0)		; get flags
00:00001A56 DD              	  6660: 	dc.b	$DD,$7E,$00
00:00001A57 7E
00:00001A58 00
                            	  6661: 			      ; 		ld	H,A			; save em
00:00001A59 67              	  6662: 	dc.b	$67
                            	  6663: 			      ; 		cp	0FFH
00:00001A5A FE              	  6664: 	dc.b	$FE,$FF
00:00001A5B FF
                            	  6665: 			      ; 		ret	Z			; eot - return FF in A for not found
00:00001A5C C8              	  6666: 	dc.b	$C8
                            	  6667: 			      ; 		bit	7,A
00:00001A5D CB              	  6668: 	dc.b	$CB,$7F
00:00001A5E 7F
                            	  6669: 			      ; 		jr	NZ,dvloop		; if if free skip this voice
00:00001A5F 20              	  6670: 	dc.b	$20,$F3
00:00001A60 F3
                            	  6671: 			      ; 		ld	A,(IX+2)
00:00001A61 DD              	  6672: 	dc.b	$DD,$7E,$02
00:00001A62 7E
00:00001A63 02
                            	  6673: 			      ; 		cp	C
00:00001A64 B9              	  6674: 	dc.b	$B9
                            	  6675: 			      ; 		jr	NZ,dvloop		; did note match?
00:00001A65 20              	  6676: 	dc.b	$20,$ED
00:00001A66 ED
                            	  6677: 			      ; 		ld	A,(IX+3)
00:00001A67 DD              	  6678: 	dc.b	$DD,$7E,$03
00:00001A68 7E
00:00001A69 03
                            	  6679: 			      ; 		cp	B			; yes - check channel
00:00001A6A B8              	  6680: 	dc.b	$B8
                            	  6681: 			      ; 		jr	NZ,dvloop
00:00001A6B 20              	  6682: 	dc.b	$20,$E7
00:00001A6C E7
                            	  6683: 			      ; 
                            	  6684: 			      ; 		ld	A,H
00:00001A6D 7C              	  6685: 	dc.b	$7C
                            	  6686: 			      ; 		zand	27H			; check for digital - locked and voice num=6
00:00001A6E E6              	  6687: 	dc.b	$E6,$27
00:00001A6F 27
                            	  6688: 			      ; 		cp	26H
00:00001A70 FE              	  6689: 	dc.b	$FE,$26
00:00001A71 26
                            	  6690: 			      ; 		jr	Z,deallocdig
00:00001A72 28              	  6691: 	dc.b	$28,$07
00:00001A73 07
                            	  6692: 			      ; 
                            	  6693: 			      ; 		zand	027H			; keep lock and vnum
00:00001A74 E6              	  6694: 	dc.b	$E6,$27
00:00001A75 27
                            	  6695: 			      ; 		zor	0C0H			; set free and release
00:00001A76 F6              	  6696: 	dc.b	$F6,$C0
00:00001A77 C0
                            	  6697: 			      ; 
                            	  6698: 			      ; 		ld	(IX+0),A		; save flags
00:00001A78 DD              	  6699: 	dc.b	$DD,$77,$00
00:00001A79 77
00:00001A7A 00
                            	  6700: 			      ; 
                            	  6701: 			      ; deallocdig
                            	  6702: 			      ; 		ld	A,H
00:00001A7B 7C              	  6703: 	dc.b	$7C
                            	  6704: 			      ; 		ret
00:00001A7C C9              	  6705: 	dc.b	$C9
                            	  6706: 			      ; 
                            	  6707: 			      ; 
                            	  6708: 			      ; 		export	Z80End
                            	  6709: 			      ; Z80End
                            	  6710: 			      ; 
                            	  6711: 			      ; **************************************  DATA AREA  ***************************************
                            	  6712: 			      ; 
                            	  6713: 			      ; 		export	PATCHDATA
                            	  6714: 			      ; PATCHDATA
                            	  6715: 			      ; 
                            	  6716: 			      ; 
                            	  6717: 			      ; EOPATCHDATA	equ	PATCHDATA + (39*16)
                            	  6718: 			      ; 
                            	  6719: 			      ; ;STACKINIT-(patchdata=39*16) = $18B0
                            	  6720: 			      ; 
                            	  6721: 			      ; STACKINIT	equ	$1B20			; inialize stack pointer right below here
                            	  6722: 			      ; MBOXES		equ	$1B20			; 32 bytes for mail boxes
                            	  6723: 			      ; CMDFIFO		equ	$1B40			; command fifo - 64 bytes
                            	  6724: 			      ; CCB		equ	$1B80			; CCB - 512 bytes
                            	  6725: 			      ; CH0BUF		equ	$1D80			; channel cache - 256 bytes
                            	  6726: 			      ; ENV0BUF		equ	$1E80			; envelope buffers - 128 bytes
                            	  6727: 			      ; DACFIFO		equ	$1F00			; DAC data FIFO - 256 bytes
                            	  6728: 			      ; 
                            	  6729: 			      ; 
                            	  6730: 			      ; 
                            	  6731: 			      ; 	END

