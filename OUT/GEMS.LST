00:00000ACC 23
                            	  2506: 			      ; 		sla	E
00:00000ACD CB              	  2507: 	dc.b	$CB,$23
00:00000ACE 23
                            	  2508: 			      ; 		rl	D			; DE <- 32 * channel
00:00000ACF CB              	  2509: 	dc.b	$CB,$12
00:00000AD0 12
