Source: "GEMS\gems.s"
                            	    76: 
                            	    77: ;     align     2
                            	    78: 	even
                            	    79: 
                            	    80: 
                            	    81: BUSREQ         EQU  $A11100             ; Z80 bus request control register
                            	    82: BUSRES         EQU  $A11200             ; Z80 reset control register
                            	    83: Z80RAM         EQU  $A00000             ; Z80 RAM in 68k addr space
                            	    84: Z80DMABLOCK    EQU  $A01b20             ; Z80 can't read 68k space if set
                            	    85: Z80DMAUNSAFE   EQU  $A01b21             ; Z80 might be reading 68k space if set
                            	    86: Z80MBOXBASE    EQU  $A01b22             ; Z80 mailbox base addr
                            	    87: 
                            	    88: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Z80 CONTROL ROUTINES ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                            	    89: 
                            	    90: 
                            	    91: ;
                            	    92: ; gemsdmastart - tell the z80 we want to do dma
                            	    93: ;
                            	    94: 
                            	    95: _gemsdmastart
                            	    96: 
                            	    97: 
00:00006934 40E7            	    98:           move.w    sr,-(SP)
00:00006936 007C0700        	    99:           or.w #$0700,sr      ; disable ints
                            	   100: 
                            	   101: dsretry
00:0000693A 33FC010000A11100	   102:           move.w    #$100,BUSREQ        ; Z80 bus request on
00:00006942 0839000000A11100	   103: dslp      btst.b    #0,BUSREQ      ; spin on bus grant
00:0000694A 66F6            	   104:           bne.s     dslp
                            	   105: 
00:0000694C 13FC000100A01B20	   106:           move.b    #1,Z80DMABLOCK      ; set dma block semaphore
00:00006954 103900A01B21    	   107:           move.b    Z80DMAUNSAFE,d0          ; get unsafe flag
                            	   108: 
00:0000695A 33FC000000A11100	   109:           move.w    #$0,BUSREQ          ; Z80 bus request off
                            	   110: 
00:00006962 4A00            	   111:           tst.b     d0             ; was it safe?
00:00006964 6708            	   112:           beq.s     dsok           ; yes
00:00006966 7044            	   113:           moveq     #68,d0              ; no, wait > 59 microsecs (ms;8[states/ms]/10[dbra])
00:00006968 51C8FFFE        	   114: dswait         dbra d0,dswait      ; wait
00:0000696C 60CC            	   115:           bra.s     dsretry
                            	   116: dsok
                            	   117: 
00:0000696E 46DF            	   118:           move.w    (sp)+,sr
00:00006970 4E75            	   119:           rts
                            	   120: 
                            	   121: ;
                            	   122: ; gemsdmaend - tell the z80 we're done with dma
                            	   123: ;
                            	   124: 
                            	   125: _gemsdmaend
                            	   126: 
00:00006972 40E7            	   127:           move.w    sr,-(SP)
00:00006974 007C0700        	   128:           or.w #$0700,sr      ; disable ints
                            	   129: 
00:00006978 610E            	   130:           jsr  _gemsholdz80
00:0000697A 13FC000000A01B20	   131:           move.b    #0,Z80DMABLOCK
00:00006982 6118            	   132:           jsr  _gemsreleasez80
                            	   133: 
00:00006984 46DF            	   134:           move.w    (sp)+,sr
00:00006986 4E75            	   135:           rts
                            	   136: 
                            	   137: ;
                            	   138: ; gemsholdz80 - take the z80 bus
                            	   139: ;
                            	   140: 
                            	   141: _gemsholdz80
                            	   142: 
00:00006988 33FC010000A11100	   143:           move.w    #$100,BUSREQ        ; Z80 bus request on
00:00006990 0839000000A11100	   144: hzlp      btst.b    #0,BUSREQ      ; spin on bus grant
00:00006998 66F6            	   145:           bne.s     hzlp
                            	   146: 
00:0000699A 4E75            	   147:           rts
                            	   148: 
                            	   149: ;
                            	   150: ; gemsreleasez80 - release the z80 bus
                            	   151: ;
                            	   152: 
                            	   153: _gemsreleasez80
                            	   154: 
00:0000699C 33FC000000A11100	   155:           move.w    #$0,BUSREQ          ; Z80 bus request off
                            	   156: 
00:000069A4 4E75            	   157:           rts
                            	   158: 
                            	   159: ;
                            	   160: ; gemsloadz80 - bus request the z80 and download the code between Z80CODE and Z80END
                            	   161: ;
                            	   162: 
                            	   163: _gemsloadz80
00:000069A6 2F09            	   164:           move.l    a1,-(sp)
00:000069A8 40E7            	   165:           move.w    sr,-(SP)
00:000069AA 007C0700        	   166:           or.w #$0700,sr      ; disable ints
                            	   167: 
00:000069AE 33FC010000A11200	   168:           move.w    #$100,BUSRES        ; Z80 bus reset off
00:000069B6 61D0            	   169:           jsr  _gemsholdz80
                            	   170: 
00:000069B8 41FA9860        	   171:           lea  _Z80CODE,a0         ; copy from 68k to z80 addr space
00:000069BC 43FAB0E2        	   172:           lea  _Z80END,a1
00:000069C0 2009            	   173:           move.l    a1,d0
00:000069C2 9088            	   174:           sub.l     a0,d0
00:000069C4 5340            	   175:           subq #1,d0               ; d0 is # of byte to copy - 1 (for dbra)
00:000069C6 43F900A00000    	   176:           lea  Z80RAM,a1
00:000069CC 12D8            	   177: lzlp1          move.b    (a0)+,(a1)+
00:000069CE 51C8FFFC        	   178:           dbra d0,lzlp1
                            	   179: 
00:000069D2 12FC0000        	   180: lzlp2          move.b    #0,(a1)+       ; zero fill remainder of 8k block
00:000069D6 B3FC00A02000    	   181:           cmpa.l    #(Z80RAM+$2000),a1
00:000069DC 66F4            	   182:           bne.s     lzlp2
                            	   183: 
00:000069DE 46DF            	   184:           move.w    (sp)+,sr
00:000069E0 225F            	   185:           move.l    (sp)+,a1
00:000069E2 4E75            	   186:           rts
                            	   187: 
                            	   188: ;
                            	   189: ; gemsstartz80 - release the z80 bus and reset the z80 (use after loadz80)
                            	   190: ;
                            	   191: 
                            	   192: _gemsstartz80
                            	   193: 
00:000069E4 40E7            	   194:           move.w    sr,-(SP)
00:000069E6 007C0700        	   195:           or.w #$0700,sr      ; disable ints
                            	   196: 
00:000069EA 33FC000000A11200	   197:           move.w    #$0,BUSRES          ; Z80 bus reset on (assumes buss rquest on)
