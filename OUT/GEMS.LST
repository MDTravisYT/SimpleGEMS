                            	   803: 			      ; DACMEJRINST	dw	0			; for saving the DACME inst for slow sample rates
00:000004CF 00              	   804: 	dc.b	$00
00:000004D0 00              	   805: 	dc.b	$00
                            	   806: 			      ; DACME4BINST	dw	0			; for saving the DACMEPROC inst for processing
00:000004D1 00              	   807: 	dc.b	$00
00:000004D2 00              	   808: 	dc.b	$00
                            	   809: 			      ; 
                            	   810: 			      ; DACME		jr	DACMEALT		; change to EXX/EX AF to enable, RET to disable
00:000004D3 18              	   811: 	dc.b	$18,$26
00:000004D4 26
                            	   812: 			      ; 
                            	   813: 			      ; ;		ret				; change to EXX (0D9H) to enable this routine
                            	   814: 			      ; ;		ex	AF,AF			; switch register set
                            	   815: 			      ; 
