                            	  6619: 			      ; 		jr	Z,avspecused
00:00001A40 28              	  6620: 	dc.b	$28,$04
00:00001A41 04
                            	  6621: 			      ; 		push	IY
00:00001A42 FD              	  6622: 	dc.b	$FD,$E5
00:00001A43 E5
                            	  6623: 			      ; 		pop	HL
00:00001A44 E1              	  6624: 	dc.b	$E1
