00:00000427 20              	   575: 	dc.b	$20,$0B
00:00000428 0B
                            	   576: 			      ; 
                            	   577: 			      ; 		ld	HL,(x68ksrclsb)		; single bank - easy: get back src addr[15:0]
00:00000429 2A              	   578: 	dc.b	$2A,$F7,$01
00:0000042A F7
00:0000042B 01
                            	   579: 			      ; 		inc	C			; C <- byte count
00:0000042C 0C              	   580: 	dc.b	$0C
                            	   581: 			      ; 		ld	B,A			; B <- src addr msb
00:0000042D 47              	   582: 	dc.b	$47
                            	   583: 			      ; 
                            	   584: 			      ; 		call	xfer68ksafe
00:0000042E CD              	   585: 	dc.b	$CD,$3D,$02
00:0000042F 3D
00:00000430 02
                            	   586: 			      ; 
                            	   587: 			      ; 		pop	IX
00:00000431 DD              	   588: 	dc.b	$DD,$E1
00:00000432 E1
                            	   589: 			      ; 		ret
00:00000433 C9              	   590: 	dc.b	$C9
                            	   591: 			      ; 
                            	   592: 			      ; x68kcrosses					; C = count-1, L=over-1
                            	   593: 			      ; 		ld	B,A			; B <- src addr msb
00:00000434 47              	   594: 	dc.b	$47
                            	   595: 			      ; 		push	BC			; push src addr msb (B)
00:00000435 C5              	   596: 	dc.b	$C5
                            	   597: 			      ; 		push	HL			; push over-1 (L)
00:00000436 E5              	   598: 	dc.b	$E5
                            	   599: 			      ; 		ld	A,C
00:00000437 79              	   600: 	dc.b	$79
                            	   601: 			      ; 		zsub	L
00:00000438 95              	   602: 	dc.b	$95
                            	   603: 			      ; 		ld	C,A			; C <- C - L = count - over (byte count for 1st part)
00:00000439 4F              	   604: 	dc.b	$4F
                            	   605: 			      ; 		ld	HL,(x68ksrclsb)		; HL <- src addr[15:0]
00:0000043A 2A              	   606: 	dc.b	$2A,$F7,$01
00:0000043B F7
00:0000043C 01
                            	   607: 			      ; 
                            	   608: 			      ; 		call	xfer68ksafe		; xfer away
00:0000043D CD              	   609: 	dc.b	$CD,$3D,$02
00:0000043E 3D
00:0000043F 02
                            	   610: 			      ; 
                            	   611: 			      ; 		pop	HL			; L <- over-1
00:00000440 E1              	   612: 	dc.b	$E1
                            	   613: 			      ; 		pop	BC			; B <- src addr msb
00:00000441 C1              	   614: 	dc.b	$C1
                            	   615: 			      ; 		ld	C,L
00:00000442 4D              	   616: 	dc.b	$4D
                            	   617: 			      ; 		inc	C			; C <- over count
00:00000443 0C              	   618: 	dc.b	$0C
                            	   619: 			      ; 		ld	A,(x68ksrcmid)
00:00000444 3A              	   620: 	dc.b	$3A,$F8,$01
00:00000445 F8
00:00000446 01
                            	   621: 			      ; 		zand	80H
00:00000447 E6              	   622: 	dc.b	$E6,$80
00:00000448 80
