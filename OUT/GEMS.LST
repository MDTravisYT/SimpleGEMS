                            	   476: 			      ; ****************************** Command FIFO (from 68000) *************************************
                            	   477: 			      ; 
                            	   478: 			      ; *
                            	   479: 			      ; *  GETCBYTE - returns the next command byte in the fifo from the 68k. will wait
