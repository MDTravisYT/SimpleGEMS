00:0000044E 30              	   630: 	dc.b	$30,$01
00:0000044F 01
                            	   631: 			      ; 		inc	B			; inc msb if lsw carried
00:00000450 04              	   632: 	dc.b	$04
                            	   633: 			      ; x68knocarry
