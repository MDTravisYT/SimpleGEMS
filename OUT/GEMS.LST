00:00000450 30              	   629: 	dc.b	$30,$01
00:00000451 01
                            	   630: 			      ; 		inc	B			; inc msb if lsw carried
00:00000452 04              	   631: 	dc.b	$04
                            	   632: 			      ; x68knocarry
                            	   633: 			      ; 		call	xfer68ksafe		; xfer away
00:00000453 CD              	   634: 	dc.b	$CD,$3D,$02
00:00000454 3D
00:00000455 02
                            	   635: 			      ; 
                            	   636: 			      ; 		pop	IX
00:00000456 DD              	   637: 	dc.b	$DD,$E1
00:00000457 E1
                            	   638: 			      ; 		ret
00:00000458 C9              	   639: 	dc.b	$C9
                            	   640: 			      ; 
                            	   641: 			      ; * xfer68kinner - inner loop of XFER68K
                            	   642: 			      ; *
                            	   643: 			      ; *	parameters:		B	68k source address [23:16]
                            	   644: 			      ; *				HL	68k source address [15:0]
                            	   645: 			      ; *				DE	Z80 dest address
                            	   646: 			      ; *				C	byte count (0 is illegal, as is any count which would
                            	   647: 			      ; *					  result in a 32k block crossing in 68k space
                            	   648: 			      ; *	trashes:		A
                            	   649: 			      ; 
                            	   650: 			      ; xfer68ksafe
                            	   651: 			      ; xfer68kinner
                            	   652: 			      ; 
                            	   653: 			      ; 	call	DACME
00:00000459 CD              	   654: 	dc.b	$CD,$B7,$02
00:0000045A B7
00:0000045B 02
                            	   655: 			      ; 
                            	   656: 			      ; 		push	DE
00:0000045C D5              	   657: 	dc.b	$D5
                            	   658: 			      ; 		ld	DE,6000H		; point to bank select register
00:0000045D 11              	   659: 	dc.b	$11,$00,$60
00:0000045E 00
00:0000045F 60
                            	   660: 			      ; 		ld	A,H
00:00000460 7C              	   661: 	dc.b	$7C
                            	   662: 			      ; 		rlc	A			; send addr[15]
00:00000461 CB              	   663: 	dc.b	$CB,$07
00:00000462 07
                            	   664: 			      ; 		ld	(DE),A
00:00000463 12              	   665: 	dc.b	$12
                            	   666: 			      ; 		ld	A,B
00:00000464 78              	   667: 	dc.b	$78
                            	   668: 			      ; 		ld	(DE),A			; send addr[16] to addr[23]
00:00000465 12              	   669: 	dc.b	$12
                            	   670: 			      ; 		rra
00:00000466 1F              	   671: 	dc.b	$1F
                            	   672: 			      ; 		ld	(DE),A
00:00000467 12              	   673: 	dc.b	$12
                            	   674: 			      ; 		rra
00:00000468 1F              	   675: 	dc.b	$1F
                            	   676: 			      ; 		ld	(DE),A
00:00000469 12              	   677: 	dc.b	$12
                            	   678: 			      ; 		rra
00:0000046A 1F              	   679: 	dc.b	$1F
                            	   680: 			      ; 		ld	(DE),A
00:0000046B 12              	   681: 	dc.b	$12
                            	   682: 			      ; 		rra
00:0000046C 1F              	   683: 	dc.b	$1F
                            	   684: 			      ; 		ld	(DE),A
00:0000046D 12              	   685: 	dc.b	$12
                            	   686: 			      ; 		rra
00:0000046E 1F              	   687: 	dc.b	$1F
                            	   688: 			      ; 		ld	(DE),A
00:0000046F 12              	   689: 	dc.b	$12
                            	   690: 			      ; 		rra
00:00000470 1F              	   691: 	dc.b	$1F
                            	   692: 			      ; 		ld	(DE),A
00:00000471 12              	   693: 	dc.b	$12
                            	   694: 			      ; 		rra
00:00000472 1F              	   695: 	dc.b	$1F
                            	   696: 			      ; 		ld	(DE),A			; 32k byte bank is now selected
00:00000473 12              	   697: 	dc.b	$12
                            	   698: 			      ; 
                            	   699: 			      ; 		pop	DE			; DE <- dest addr
00:00000474 D1              	   700: 	dc.b	$D1
                            	   701: 			      ; 		zset	7,H			; HL <- source addr, in 32k byte bank window
00:00000475 CB              	   702: 	dc.b	$CB,$FC
00:00000476 FC
                            	   703: 			      ; 		ld	A,C			; A <- byte count
00:00000477 79              	   704: 	dc.b	$79
                            	   705: 			      ; 		ld	B,0			; clear msb of BC
00:00000478 06              	   706: 	dc.b	$06,$00
00:00000479 00
                            	   707: 			      ; 
                            	   708: 			      ; 	call	DACME
00:0000047A CD              	   709: 	dc.b	$CD,$B7,$02
00:0000047B B7
00:0000047C 02
                            	   710: 			      ; 
                            	   711: 			      ; 		zset	0,(IX+1)		; MBOX[1] tells 68k that Z80 might be xfering
00:0000047D DD              	   712: 	dc.b	$DD,$CB,$01,$C6
00:0000047E CB
00:0000047F 01
00:00000480 C6
