                            	  6649: 			      ; 
                            	  6650: 			      ; 
                            	  6651: 			      ; *  DEALLOC - deallocate a voice by searching for a match on notenum and channel.
                            	  6652: 			      ; *    for now - for digital do nuthing
                            	  6653: 			      ; *    if release timer (byte 6) is zero, then set free bit immediately, otherwise
                            	  6654: 			      ; *    set release bit (a 60 Hz routine will count this down and set free when its zero)
                            	  6655: 			      ; *
                            	  6656: 			      ; *	parameters:	B	channel
                            	  6657: 			      ; *			C	note
                            	  6658: 			      ; *			IX	top of voice table
                            	  6659: 			      ; *
                            	  6660: 			      ; *	uses:		D,E,H
                            	  6661: 			      ; *
                            	  6662: 			      ; *	returns:	A	flags byte of deallocated voice, or
                            	  6663: 			      ; *				  0FFH if note not found
                            	  6664: 			      ; 
                            	  6665: 			      ; DEALLOC
                            	  6666: 			      ; 		ld	DE,7
00:00001A72 11              	  6667: 	dc.b	$11,$07,$00
00:00001A73 07
00:00001A74 00
                            	  6668: 			      ; 		jr	dvstart
00:00001A75 18              	  6669: 	dc.b	$18,$02
00:00001A76 02
                            	  6670: 			      ; dvloop
                            	  6671: 			      ; 		zadd	IX,DE
00:00001A77 DD              	  6672: 	dc.b	$DD,$19
00:00001A78 19
                            	  6673: 			      ; dvstart
                            	  6674: 			      ; 		ld	A,(IX+0)		; get flags
00:00001A79 DD              	  6675: 	dc.b	$DD,$7E,$00
00:00001A7A 7E
00:00001A7B 00
                            	  6676: 			      ; 		ld	H,A			; save em
00:00001A7C 67              	  6677: 	dc.b	$67
                            	  6678: 			      ; 		cp	0FFH
00:00001A7D FE              	  6679: 	dc.b	$FE,$FF
00:00001A7E FF
                            	  6680: 			      ; 		ret	Z			; eot - return FF in A for not found
00:00001A7F C8              	  6681: 	dc.b	$C8
                            	  6682: 			      ; 		bit	7,A
00:00001A80 CB              	  6683: 	dc.b	$CB,$7F
00:00001A81 7F
                            	  6684: 			      ; 		jr	NZ,dvloop		; if if free skip this voice
00:00001A82 20              	  6685: 	dc.b	$20,$F3
00:00001A83 F3
                            	  6686: 			      ; 		ld	A,(IX+2)
00:00001A84 DD              	  6687: 	dc.b	$DD,$7E,$02
00:00001A85 7E
00:00001A86 02
                            	  6688: 			      ; 		cp	C
00:00001A87 B9              	  6689: 	dc.b	$B9
                            	  6690: 			      ; 		jr	NZ,dvloop		; did note match?
00:00001A88 20              	  6691: 	dc.b	$20,$ED
00:00001A89 ED
                            	  6692: 			      ; 		ld	A,(IX+3)
00:00001A8A DD              	  6693: 	dc.b	$DD,$7E,$03
00:00001A8B 7E
00:00001A8C 03
                            	  6694: 			      ; 		cp	B			; yes - check channel
00:00001A8D B8              	  6695: 	dc.b	$B8
                            	  6696: 			      ; 		jr	NZ,dvloop
00:00001A8E 20              	  6697: 	dc.b	$20,$E7
00:00001A8F E7
                            	  6698: 			      ; 
                            	  6699: 			      ; 		ld	A,H
00:00001A90 7C              	  6700: 	dc.b	$7C
                            	  6701: 			      ; 		zand	27H			; check for digital - locked and voice num=6
00:00001A91 E6              	  6702: 	dc.b	$E6,$27
00:00001A92 27
                            	  6703: 			      ; 		cp	26H
00:00001A93 FE              	  6704: 	dc.b	$FE,$26
00:00001A94 26
                            	  6705: 			      ; 		jr	Z,deallocdig
00:00001A95 28              	  6706: 	dc.b	$28,$07
00:00001A96 07
                            	  6707: 			      ; 
                            	  6708: 			      ; 		zand	027H			; keep lock and vnum
00:00001A97 E6              	  6709: 	dc.b	$E6,$27
00:00001A98 27
                            	  6710: 			      ; 		zor	0C0H			; set free and release
00:00001A99 F6              	  6711: 	dc.b	$F6,$C0
00:00001A9A C0
                            	  6712: 			      ; 
                            	  6713: 			      ; 		ld	(IX+0),A		; save flags
00:00001A9B DD              	  6714: 	dc.b	$DD,$77,$00
00:00001A9C 77
00:00001A9D 00
                            	  6715: 			      ; 
                            	  6716: 			      ; deallocdig
                            	  6717: 			      ; 		ld	A,H
00:00001A9E 7C              	  6718: 	dc.b	$7C
                            	  6719: 			      ; 		ret
00:00001A9F C9              	  6720: 	dc.b	$C9
