Source: "src\sub\bcd.s"
                            	     1: ; vvv Code by Devon vvv
                            	     2: ; ----------------------------------------------------------------------
                            	     3: ; Convert word to BCD format
                            	     4: ; ----------------------------------------------------------------------
                            	     5: ; PARAMETERS:
                            	     6: ;    d1.w - Number to convert
                            	     7: ; RETURNS:
                            	     8: ;    d1.w - Converted number
                            	     9: ; ----------------------------------------------------------------------
                            	    10: 
                            	    11: WordToBcd:
00:00006FE2 3F00            	    12:     move.w    d0,-(sp)                ; Save d0
                            	    13:     
00:00006FE4 02810000FFFF    	    14:     andi.l    #$FFFF,d1                ; Get 1st digit
00:00006FEA 82FC000A        	    15:     divu.w    #10,d1
00:00006FEE 4841            	    16:     swap    d1
00:00006FF0 3001            	    17:     move.w    d1,d0
00:00006FF2 4241            	    18:     clr.w    d1
00:00006FF4 4841            	    19:     swap    d1
                            	    20:     
00:00006FF6 82FC000A        	    21:     divu.w    #10,d1                    ; Get 2nd digit
00:00006FFA 4841            	    22:     swap    d1
00:00006FFC E949            	    23:     lsl.w    #4,d1
00:00006FFE D041            	    24:     add.w    d1,d0
00:00007000 4241            	    25:     clr.w    d1
00:00007002 4841            	    26:     swap    d1
                            	    27:     
00:00007004 82FC000A        	    28:     divu.w    #10,d1                    ; Get 3rd digit
00:00007008 4841            	    29:     swap    d1
00:0000700A 1F01            	    30:     move.b    d1,-(sp)
00:0000700C 422F0001        	    31:     clr.b    1(sp)
00:00007010 D05F            	    32:     add.w    (sp)+,d0
00:00007012 4241            	    33:     clr.w    d1
00:00007014 4841            	    34:     swap    d1
                            	    35:     
00:00007016 82FC000A        	    36:     divu.w    #10,d1                    ; Get 4th digit
00:0000701A 4841            	    37:     swap    d1
00:0000701C 1F01            	    38:     move.b    d1,-(sp)
00:0000701E 321F            	    39:     move.w    (sp)+,d1
00:00007020 4201            	    40:     clr.b    d1
00:00007022 E949            	    41:     lsl.w    #4,d1
00:00007024 D041            	    42:     add.w    d1,d0
                            	    43:     
00:00007026 3200            	    44:     move.w    d0,d1                    ; Get result
00:00007028 301F            	    45:     move.w    (sp)+,d0                ; Restore d0
00:0000702A 4E75            	    46:     rts

