Source: "src\system\macros.i"
                            	     1: InitTXT	macro	src,x,y
                            	     2: 	lea		src,	a0
                            	     3: 	lea		VDPDATA,a1
                            	     4: 	move.l	#(\src\_end-src)-1,	d0
                            	     5: 	move.l	#$40000002+(x*$20000)+(y*$800000),(VDPCTRL)
                            	     6: 	moveq	#0,	d1
                            	     7: 	jsr		printASCII
                            	     8: 	endm
                            	     9: 	
                            	    10: DefTXT	macro	title,data
                            	    11: 	\title:	dc.b	\data
                            	    12: 	\title\_end:	even
                            	    13: 	endm
                            	    14: 	
                            	    15: ARTLIST		MACRO	LOC,	DEST
                            	    16: 	dc.w	((\LOC\_end-LOC)/4)-1
                            	    17: 	dc.l	VRAMWRITE+((DEST&$3FFF)<<16)+((DEST&$C000)>>14)
                            	    18: 	dc.l	LOC
                            	    19: 	ENDM
                            	    20: 		
                            	    21: ARTLIST_END	MACRO
                            	    22: 	dc.l	-1
                            	    23: 	even
                            	    24: 	ENDM

