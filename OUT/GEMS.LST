                            	   717: 			      ; 		jr	C,x68klast
00:00000483 38              	   718: 	dc.b	$38,$11
00:00000484 11
                            	   719: 			      ; x68kloop
                            	   720: 			      ; 		ld	C,6			; yes - xfer maxcnt bytes
00:00000485 0E              	   721: 	dc.b	$0E,$06
00:00000486 06
                            	   722: 			      ; ;		ld	C,12			; yes - xfer maxcnt bytes
                            	   723: 			      ; 		bit	0,(IX)			; MBOX[0] is block flag from 68k
00:00000487 DD              	   724: 	dc.b	$DD,$CB,$00,$46
00:00000488 CB
00:00000489 00
00:0000048A 46
                            	   725: 			      ; 		jr	NZ,x68klpwt
00:0000048B 20              	   726: 	dc.b	$20,$1C
00:0000048C 1C
                            	   727: 			      ; x68klpcont
                            	   728: 			      ; 		ldir
00:0000048D ED              	   729: 	dc.b	$ED,$B0
00:0000048E B0
                            	   730: 			      ; 
                            	   731: 			      ; 	call	DACME
00:0000048F CD              	   732: 	dc.b	$CD,$B7,$02
00:00000490 B7
00:00000491 02
                            	   733: 			      ; 
                            	   734: 			      ; 		zsub	6			; more than maxcnt left?
00:00000492 D6              	   735: 	dc.b	$D6,$06
00:00000493 06
