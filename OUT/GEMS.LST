                            	  1201: 			      ; 
                            	  1202: 			      ; ************************************* SEQUENCER CODE ***************************************
                            	  1203: 			      ; 
                            	  1204: 			      ; * CCB Entries:	2,1,0	tag addr of 1st byte in 32-byte channel buffer
                            	  1205: 			      ; *		5,4,3	addr of next byte to fetch
                            	  1206: 			      ; *				so: 0 <= addr-tag <= 31 means hit in buffer
                            	  1207: 			      ; *		6	flags
                            	  1208: 			      ; *		8,7	timer (contains 0-ticks to delay)
                            	  1209: 			      ; *		10,9	delay
                            	  1210: 			      ; *		12,11	duration
                            	  1211: 			      ; 
                            	  1212: 			      ; CCBTAGL		equ	0	; lsb of addr of 1st byte in 32-byte sequence buffer
                            	  1213: 			      ; CCBTAGM		equ	1	; mid of "
                            	  1214: 			      ; CCBTAGH		equ	2	; msb of "
                            	  1215: 			      ; CCBADDRL	equ	3	; lsb of addr of next byte to read from sequence
                            	  1216: 			      ; CCBADDRM	equ	4	; mid of "
                            	  1217: 			      ; CCBADDRH	equ	5	; msb of "
                            	  1218: 			      ; CCBFLAGS	equ	6	; 80 = sustain
                            	  1219: 			      ; 				; 40 = env retrigger
                            	  1220: 			      ; 				; 20 = lock (for 68k based sfx)
                            	  1221: 			      ; 				; 10 = running (not paused)
                            	  1222: 			      ; 				; 08 = use sfx (150 bpm) timebase
                            	  1223: 			      ; 				; 02 = muted (running, but not executing note ons)
                            	  1224: 			      ; 				; 01 = in use
                            	  1225: 			      ; CCBTIMERL	equ	7	; lsb of 2's comp, subbeat (1/24th) timer till next event
                            	  1226: 			      ; CCBTIMERH	equ	8	; msb of "
                            	  1227: 			      ; CCBDELL		equ	9	; lsb of registered subbeat delay value
                            	  1228: 			      ; CCBDELH		equ	10	; msb of "
                            	  1229: 			      ; CCBDURL		equ	11	; lsb of registered subbeat duration value
                            	  1230: 			      ; CCBDURH		equ	12	; msb of "
                            	  1231: 			      ; CCBPNUM		equ	13	; program number (patch)
                            	  1232: 			      ; CCBSNUM		equ	14	; sequence number (in sequence bank)
                            	  1233: 			      ; CCBVCHAN	equ	15	; MIDI channel number within sequence CCBSNUM
                            	  1234: 			      ; CCBLOOP0	equ	16	; loop stack (counter, lsb of start addr, mid of start addr)
                            	  1235: 			      ; CCBLOOP1	equ	19
                            	  1236: 			      ; CCBLOOP2	equ	22
                            	  1237: 			      ; CCBLOOP3	equ	25
                            	  1238: 			      ; CCBPRIO		equ	28	; priority (0 lowest, 127 highest)
                            	  1239: 			      ; CCBENV		equ	29	; envelope number
                            	  1240: 			      ; CCBATN		equ	30	; channel attenuation (0=loud, 127=quiet)
                            	  1241: 			      ; CCBy		equ	31
                            	  1242: 			      ; 
                            	  1243: 			      ; *
                            	  1244: 			      ; *  GETSBYTE - get the channel's sequence byte pointed to by the CCB
                            	  1245: 			      ; *
                            	  1246: 			      ; *	parameters:		IX		points to the current channel's CCB
                            	  1247: 			      ; *				(CHBUFPTR)	points to the current channel's buffer
                            	  1248: 			      ; *	returns:		A		data
                            	  1249: 			      ; *
                            	  1250: 			      ; 
                            	  1251: 			      ; ;BUFSIZE		equ	16
                            	  1252: 			      ; 
                            	  1253: 			      ; GETSBYTE
