                            	  5818: 			      ; 
                            	  5819: 			      ; *
                            	  5820: 			      ; * WRITEFM - write a string of values to the FM chip. BC points to a null-terminated
                            	  5821: 			      ; *   list of reg/data pairs, where data is an offset off of IX. if data is 0, the
                            	  5822: 			      ; *   indirection is skipped and a 0 written (for the "proprietary register")
                            	  5823: 			      ; *   H <- 40H (MSB of FM chip register address)
                            	  5824: 			      ; *   D <- 0 for bank 0 (channels 0,1,2) or 2 for bank 1 (channels 3,4,5)
                            	  5825: 			      ; *   E <- channel within bank (0-2)
                            	  5826: 			      ; *
                            	  5827: 			      ; 		export	WRITEFM
                            	  5828: 			      ; WRITEFM
                            	  5829: 			      ; 		ld	A,(BC)			; get reg num
