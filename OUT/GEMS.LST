                            	   533: 			      ; **************************************  XFER68K  *****************************************
                            	   534: 			      ; 
                            	   535: 			      ; *
                            	   536: 			      ; *  XFER68K - transfers 1 to 255 bytes from 68000 space to Z80. handles 32k block crossings.
                            	   537: 			      ; *
                            	   538: 			      ; *	parameters:		A	68k source address [23:16]
                            	   539: 			      ; *				HL	68k source address [15:0]
                            	   540: 			      ; *				DE	Z80 dest address
                            	   541: 			      ; *				C	byte count (0 is illegal!)
                            	   542: 			      ; *
                            	   543: 			      ; *	trashes:		B
                            	   544: 			      ; *
                            	   545: 			      ; 
                            	   546: 			      ; x68ksrclsb	db	0			; for storing lsw of src addr
00:00000413 00              	   547: 	dc.b	$00
                            	   548: 			      ; x68ksrcmid	db	0
00:00000414 00              	   549: 	dc.b	$00
                            	   550: 			      ; 
                            	   551: 			      ; XFER68K
                            	   552: 			      ; 
                            	   553: 			      ; 	call	DACME
00:00000415 CD              	   554: 	dc.b	$CD,$B7,$02
00:00000416 B7
00:00000417 02
                            	   555: 			      ; 
                            	   556: 			      ; 		push	IX			; save IX - use it to point to DMA block flags
00:00000418 DD              	   557: 	dc.b	$DD,$E5
00:00000419 E5
                            	   558: 			      ; 		ld	IX,MBOXES
00:0000041A DD              	   559: 	dc.b	$DD,$21,$20,$1B
00:0000041B 21
00:0000041C 20
00:0000041D 1B
                            	   560: 			      ; 
                            	   561: 			      ; 		ld	(x68ksrclsb),HL		; save src addr[15:0]
00:0000041E 22              	   562: 	dc.b	$22,$F7,$01
00:0000041F F7
00:00000420 01
                            	   563: 			      ; 		res	7,H			; HL <- src addr[14:0]
00:00000421 CB              	   564: 	dc.b	$CB,$BC
00:00000422 BC
                            	   565: 			      ; 		ld	B,0
00:00000423 06              	   566: 	dc.b	$06,$00
00:00000424 00
                            	   567: 			      ; 		dec	C			; BC <- count-1
00:00000425 0D              	   568: 	dc.b	$0D
                            	   569: 			      ; 		zadd	HL,BC			; HL addr within 32k byte bank of last byte to xfer
00:00000426 09              	   570: 	dc.b	$09
