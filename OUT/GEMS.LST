00:00000451 CD              	   635: 	dc.b	$CD,$3D,$02
00:00000452 3D
00:00000453 02
                            	   636: 			      ; 
                            	   637: 			      ; 		pop	IX
00:00000454 DD              	   638: 	dc.b	$DD,$E1
00:00000455 E1
                            	   639: 			      ; 		ret
00:00000456 C9              	   640: 	dc.b	$C9
                            	   641: 			      ; 
                            	   642: 			      ; * xfer68kinner - inner loop of XFER68K
                            	   643: 			      ; *
                            	   644: 			      ; *	parameters:		B	68k source address [23:16]
                            	   645: 			      ; *				HL	68k source address [15:0]
                            	   646: 			      ; *				DE	Z80 dest address
                            	   647: 			      ; *				C	byte count (0 is illegal, as is any count which would
                            	   648: 			      ; *					  result in a 32k block crossing in 68k space
                            	   649: 			      ; *	trashes:		A
                            	   650: 			      ; 
                            	   651: 			      ; xfer68ksafe
                            	   652: 			      ; xfer68kinner
                            	   653: 			      ; 
                            	   654: 			      ; 	call	DACME
00:00000457 CD              	   655: 	dc.b	$CD,$B7,$02
00:00000458 B7
00:00000459 02
                            	   656: 			      ; 
                            	   657: 			      ; 		push	DE
00:0000045A D5              	   658: 	dc.b	$D5
                            	   659: 			      ; 		ld	DE,6000H		; point to bank select register
00:0000045B 11              	   660: 	dc.b	$11,$00,$60
00:0000045C 00
00:0000045D 60
                            	   661: 			      ; 		ld	A,H
00:0000045E 7C              	   662: 	dc.b	$7C
                            	   663: 			      ; 		rlc	A			; send addr[15]
00:0000045F CB              	   664: 	dc.b	$CB,$07
00:00000460 07
                            	   665: 			      ; 		ld	(DE),A
00:00000461 12              	   666: 	dc.b	$12
                            	   667: 			      ; 		ld	A,B
00:00000462 78              	   668: 	dc.b	$78
                            	   669: 			      ; 		ld	(DE),A			; send addr[16] to addr[23]
00:00000463 12              	   670: 	dc.b	$12
                            	   671: 			      ; 		rra
00:00000464 1F              	   672: 	dc.b	$1F
                            	   673: 			      ; 		ld	(DE),A
00:00000465 12              	   674: 	dc.b	$12
                            	   675: 			      ; 		rra
00:00000466 1F              	   676: 	dc.b	$1F
                            	   677: 			      ; 		ld	(DE),A
00:00000467 12              	   678: 	dc.b	$12
                            	   679: 			      ; 		rra
00:00000468 1F              	   680: 	dc.b	$1F
                            	   681: 			      ; 		ld	(DE),A
00:00000469 12              	   682: 	dc.b	$12
                            	   683: 			      ; 		rra
00:0000046A 1F              	   684: 	dc.b	$1F
                            	   685: 			      ; 		ld	(DE),A
00:0000046B 12              	   686: 	dc.b	$12
                            	   687: 			      ; 		rra
00:0000046C 1F              	   688: 	dc.b	$1F
                            	   689: 			      ; 		ld	(DE),A
00:0000046D 12              	   690: 	dc.b	$12
                            	   691: 			      ; 		rra
00:0000046E 1F              	   692: 	dc.b	$1F
                            	   693: 			      ; 		ld	(DE),A
00:0000046F 12              	   694: 	dc.b	$12
                            	   695: 			      ; 		rra
00:00000470 1F              	   696: 	dc.b	$1F
                            	   697: 			      ; 		ld	(DE),A			; 32k byte bank is now selected
00:00000471 12              	   698: 	dc.b	$12
                            	   699: 			      ; 
                            	   700: 			      ; 		pop	DE			; DE <- dest addr
00:00000472 D1              	   701: 	dc.b	$D1
                            	   702: 			      ; 		zset	7,H			; HL <- source addr, in 32k byte bank window
00:00000473 CB              	   703: 	dc.b	$CB,$FC
00:00000474 FC
                            	   704: 			      ; 		ld	A,C			; A <- byte count
00:00000475 79              	   705: 	dc.b	$79
                            	   706: 			      ; 		ld	B,0			; clear msb of BC
00:00000476 06              	   707: 	dc.b	$06,$00
00:00000477 00
                            	   708: 			      ; 
                            	   709: 			      ; 	call	DACME
00:00000478 CD              	   710: 	dc.b	$CD,$B7,$02
00:00000479 B7
00:0000047A 02
                            	   711: 			      ; 
                            	   712: 			      ; 		zset	0,(IX+1)		; MBOX[1] tells 68k that Z80 might be xfering
00:0000047B DD              	   713: 	dc.b	$DD,$CB,$01,$C6
00:0000047C CB
00:0000047D 01
00:0000047E C6
