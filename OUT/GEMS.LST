Source: "src\sub\bcd.s"
                            	     1: ; vvv Code by Devon vvv
                            	     2: ; ----------------------------------------------------------------------
                            	     3: ; Convert word to BCD format
                            	     4: ; ----------------------------------------------------------------------
                            	     5: ; PARAMETERS:
                            	     6: ;    d1.w - Number to convert
                            	     7: ; RETURNS:
                            	     8: ;    d1.w - Converted number
                            	     9: ; ----------------------------------------------------------------------
                            	    10: 
                            	    11: WordToBcd:
00:00014B84 3F00            	    12:     move.w    d0,-(sp)                ; Save d0
                            	    13:     
00:00014B86 02810000FFFF    	    14:     andi.l    #$FFFF,d1                ; Get 1st digit
00:00014B8C 82FC000A        	    15:     divu.w    #10,d1
00:00014B90 4841            	    16:     swap    d1
00:00014B92 3001            	    17:     move.w    d1,d0
00:00014B94 4241            	    18:     clr.w    d1
00:00014B96 4841            	    19:     swap    d1
                            	    20:     
00:00014B98 82FC000A        	    21:     divu.w    #10,d1                    ; Get 2nd digit
00:00014B9C 4841            	    22:     swap    d1
00:00014B9E E949            	    23:     lsl.w    #4,d1
00:00014BA0 D041            	    24:     add.w    d1,d0
00:00014BA2 4241            	    25:     clr.w    d1
00:00014BA4 4841            	    26:     swap    d1
                            	    27:     
00:00014BA6 82FC000A        	    28:     divu.w    #10,d1                    ; Get 3rd digit
00:00014BAA 4841            	    29:     swap    d1
00:00014BAC 1F01            	    30:     move.b    d1,-(sp)
00:00014BAE 422F0001        	    31:     clr.b    1(sp)
00:00014BB2 D05F            	    32:     add.w    (sp)+,d0
00:00014BB4 4241            	    33:     clr.w    d1
00:00014BB6 4841            	    34:     swap    d1
                            	    35:     
00:00014BB8 82FC000A        	    36:     divu.w    #10,d1                    ; Get 4th digit
00:00014BBC 4841            	    37:     swap    d1
00:00014BBE 1F01            	    38:     move.b    d1,-(sp)
00:00014BC0 321F            	    39:     move.w    (sp)+,d1
00:00014BC2 4201            	    40:     clr.b    d1
00:00014BC4 E949            	    41:     lsl.w    #4,d1
00:00014BC6 D041            	    42:     add.w    d1,d0
                            	    43:     
00:00014BC8 3200            	    44:     move.w    d0,d1                    ; Get result
00:00014BCA 301F            	    45:     move.w    (sp)+,d0                ; Restore d0
00:00014BCC 4E75            	    46:     rts

