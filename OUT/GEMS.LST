Source: "GEMS\gems.s"
                            	    82: 
                            	    83: ;     align     2
                            	    84: 	even
                            	    85: 
                            	    86: 
                            	    87: BUSREQ         EQU  $A11100             ; Z80 bus request control register
                            	    88: BUSRES         EQU  $A11200             ; Z80 reset control register
                            	    89: Z80RAM         EQU  $A00000             ; Z80 RAM in 68k addr space
                            	    90: Z80DMABLOCK    EQU  $A01b20             ; Z80 can't read 68k space if set
                            	    91: Z80DMAUNSAFE   EQU  $A01b21             ; Z80 might be reading 68k space if set
                            	    92: Z80MBOXBASE    EQU  $A01b22             ; Z80 mailbox base addr
                            	    93: 
                            	    94: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Z80 CONTROL ROUTINES ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                            	    95: 
                            	    96: 
                            	    97: ;
                            	    98: ; gemsdmastart - tell the z80 we want to do dma
                            	    99: ;
                            	   100: 
                            	   101: _gemsdmastart
                            	   102: 
                            	   103: 
00:00014488 40E7            	   104:           move.w    sr,-(SP)
00:0001448A 007C0700        	   105:           or.w #$0700,sr      ; disable ints
                            	   106: 
                            	   107: dsretry
00:0001448E 33FC010000A11100	   108:           move.w    #$100,BUSREQ        ; Z80 bus request on
00:00014496 0839000000A11100	   109: dslp      btst.b    #0,BUSREQ      ; spin on bus grant
00:0001449E 66F6            	   110:           bne.s     dslp
                            	   111: 
00:000144A0 13FC000100A01B20	   112:           move.b    #1,Z80DMABLOCK      ; set dma block semaphore
00:000144A8 103900A01B21    	   113:           move.b    Z80DMAUNSAFE,d0          ; get unsafe flag
                            	   114: 
00:000144AE 33FC000000A11100	   115:           move.w    #$0,BUSREQ          ; Z80 bus request off
                            	   116: 
00:000144B6 4A00            	   117:           tst.b     d0             ; was it safe?
00:000144B8 6708            	   118:           beq.s     dsok           ; yes
00:000144BA 7044            	   119:           moveq     #68,d0              ; no, wait > 59 microsecs (ms;8[states/ms]/10[dbra])
00:000144BC 51C8FFFE        	   120: dswait         dbra d0,dswait      ; wait
00:000144C0 60CC            	   121:           bra.s     dsretry
                            	   122: dsok
                            	   123: 
00:000144C2 46DF            	   124:           move.w    (sp)+,sr
00:000144C4 4E75            	   125:           rts
                            	   126: 
                            	   127: ;
                            	   128: ; gemsdmaend - tell the z80 we're done with dma
                            	   129: ;
                            	   130: 
                            	   131: _gemsdmaend
                            	   132: 
00:000144C6 40E7            	   133:           move.w    sr,-(SP)
00:000144C8 007C0700        	   134:           or.w #$0700,sr      ; disable ints
                            	   135: 
00:000144CC 610E            	   136:           jsr  _gemsholdz80
00:000144CE 13FC000000A01B20	   137:           move.b    #0,Z80DMABLOCK
00:000144D6 6118            	   138:           jsr  _gemsreleasez80
                            	   139: 
00:000144D8 46DF            	   140:           move.w    (sp)+,sr
00:000144DA 4E75            	   141:           rts
                            	   142: 
                            	   143: ;
                            	   144: ; gemsholdz80 - take the z80 bus
                            	   145: ;
                            	   146: 
                            	   147: _gemsholdz80
                            	   148: 
00:000144DC 33FC010000A11100	   149:           move.w    #$100,BUSREQ        ; Z80 bus request on
00:000144E4 0839000000A11100	   150: hzlp      btst.b    #0,BUSREQ      ; spin on bus grant
00:000144EC 66F6            	   151:           bne.s     hzlp
                            	   152: 
00:000144EE 4E75            	   153:           rts
                            	   154: 
                            	   155: ;
                            	   156: ; gemsreleasez80 - release the z80 bus
                            	   157: ;
                            	   158: 
                            	   159: _gemsreleasez80
                            	   160: 
00:000144F0 33FC000000A11100	   161:           move.w    #$0,BUSREQ          ; Z80 bus request off
                            	   162: 
00:000144F8 4E75            	   163:           rts
                            	   164: 
                            	   165: ;
                            	   166: ; gemsloadz80 - bus request the z80 and download the code between Z80CODE and Z80END
                            	   167: ;
                            	   168: 
                            	   169: _gemsloadz80
00:000144FA 2F09            	   170:           move.l    a1,-(sp)
00:000144FC 40E7            	   171:           move.w    sr,-(SP)
00:000144FE 007C0700        	   172:           or.w #$0700,sr      ; disable ints
                            	   173: 
00:00014502 33FC010000A11200	   174:           move.w    #$100,BUSRES        ; Z80 bus reset off
00:0001450A 61D0            	   175:           jsr  _gemsholdz80
                            	   176: 
00:0001450C 41F90000021C    	   177:           lea  _Z80CODE,a0         ; copy from 68k to z80 addr space
00:00014512 43F900001A7D    	   178:           lea  _Z80END,a1
00:00014518 2009            	   179:           move.l    a1,d0
00:0001451A 9088            	   180:           sub.l     a0,d0
00:0001451C 5340            	   181:           subq #1,d0               ; d0 is # of byte to copy - 1 (for dbra)
00:0001451E 43F900A00000    	   182:           lea  Z80RAM,a1
00:00014524 12D8            	   183: lzlp1          move.b    (a0)+,(a1)+
00:00014526 51C8FFFC        	   184:           dbra d0,lzlp1
                            	   185: 
00:0001452A 12FC0000        	   186: lzlp2          move.b    #0,(a1)+       ; zero fill remainder of 8k block
00:0001452E B3FC00A02000    	   187:           cmpa.l    #(Z80RAM+$2000),a1
00:00014534 66F4            	   188:           bne.s     lzlp2
                            	   189: 
00:00014536 46DF            	   190:           move.w    (sp)+,sr
00:00014538 225F            	   191:           move.l    (sp)+,a1
00:0001453A 4E75            	   192:           rts
                            	   193: 
                            	   194: ;
                            	   195: ; gemsstartz80 - release the z80 bus and reset the z80 (use after loadz80)
                            	   196: ;
                            	   197: 
                            	   198: _gemsstartz80
                            	   199: 
00:0001453C 40E7            	   200:           move.w    sr,-(SP)
00:0001453E 007C0700        	   201:           or.w #$0700,sr      ; disable ints
                            	   202: 
00:00014542 33FC000000A11200	   203:           move.w    #$0,BUSRES          ; Z80 bus reset on (assumes buss rquest on)
00:0001454A 203C0000000F    	   204:           move.l    #15,d0              ; a loop > 26 uS
00:00014550 5380            	   205: szlp      subq.l    #1,d0
00:00014552 66FC            	   206:           bne.s     szlp
00:00014554 33FC000000A11100	   207:           move.w    #$0,BUSREQ          ; Z80 bus request off
00:0001455C 33FC010000A11200	   208:           move.w    #$100,BUSRES        ; Z80 bus reset off
                            	   209: 
00:00014564 46DF            	   210:           move.w    (sp)+,sr
00:00014566 4E75            	   211:           rts
                            	   212: 
                            	   213: ;
                            	   214: ; stdsetup - setup these regs:
                            	   215: ;  d1 - the old value of wptr
                            	   216: ;  a0 - Z80RAM+$36(wptr)
                            	   217: ;  a1 - Z80RAM+$1B40(fifo)
                            	   218: ; also save the sr, turns off ints, and holds the z80
                            	   219: ;
                            	   220: stdsetup
00:00014568 205F            	   221:           move.l    (sp)+,a0       ; get the return addr
00:0001456A 4E560000        	   222:           link a6,#0               ; set up the link
00:0001456E 48E74040        	   223:           movem.l   d1/a1,-(sp)         ; save some regs
00:00014572 40E7            	   224:           move.w    sr,-(SP)
                            	   225: 
00:00014574 2F08            	   226:           move.l    a0,-(sp)       ; push the return addr
                            	   227: 
00:00014576 41F900A00036    	   228:           lea  Z80RAM+$36,a0       ; a0 points to wptr
00:0001457C 43F900A01B40    	   229:           lea  Z80RAM+$1B40,a1          ; a1 points to fifo
                            	   230: 
00:00014582 007C0700        	   231:           or.w #$0700,sr      ; disable ints
                            	   232: 
00:00014586 33FC010000A11100	   233:           move.w    #$100,BUSREQ        ; Z80 bus request on
00:0001458E 0839000000A11100	   234: sslp      btst.b    #0,BUSREQ      ; spin on bus grant
00:00014596 66F6            	   235:           bne.s     sslp
                            	   236: 
00:00014598 1210            	   237:           move.b    (a0),d1             ; d1 is write index into fifo
